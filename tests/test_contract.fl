(load "/root/apps/bigwash-contract/src/contract.fl")

(println "--- Contract Test Start ---")

;; 1. Create Contract
(let [[items [{:description "Washing Service" :quantity 10 :unit_price 50.0}
              {:description "Detergent" :quantity 5 :unit_price 10.0}]]
      [customer-write (db_exec DB "INSERT INTO customers (name, migration_status) VALUES ('계약 테스트 고객', 'VERIFIED')" [])]
      [customer-row (first (db_query DB "SELECT id FROM customers WHERE name = '계약 테스트 고객'" []))]
      [customer-id (get customer-row :id)]
      [amount 550.0]]
  (let [[result (create-contract customer-id amount items)]]
    (println "Contract created: " result)
    (let [[contract-id (get result :id)]]

      ;; 2. Get Contract
      (let [[contract-data (get-contract contract-id)]]
        (println "Retrieved contract: " (get contract-data :contract))
        (println "Retrieved items: " (get contract-data :items)))

      ;; 3. Update Status (DRAFT -> PENDING)
      (let [[update-res (update-status contract-id "PENDING")]]
        (println "Status updated to PENDING: " update-res))

      ;; 4. List PENDING contracts
      (let [[pending-list (list-contracts "PENDING")]]
        (println "Pending contracts count: " (length pending-list)))

      ;; 5. Invalid transition (PENDING -> COMPLETED is invalid, should go to APPROVED first)
      (try
        (update-status contract-id "COMPLETED")
        (catch [e] (println "Expected error caught (Invalid transition): " e))))))

(println "--- Contract Test End ---")
