(define REPO-ROOT
  (let [override (env-get "BIGWASH_REPO_ROOT")]
    (if (or (nil? override) (str-blank? override)) (env-get "PWD") override)))
(load (str REPO-ROOT "/src/washcare.fl"))

(if (= DB (str REPO-ROOT "/db/contracts.sqlite"))
  (error "test_site_checklist.fl requires BIGWASH_DB_PATH pointing to an isolated test database"))

(db_exec DB
  "DELETE FROM site_checklist_items WHERE checklist_id IN (
     SELECT sc.id FROM site_checklists sc
     JOIN sites s ON s.id = sc.site_id
     WHERE s.name LIKE '주소체크테스트 %'
   )" [])
(db_exec DB
  "DELETE FROM site_checklists WHERE site_id IN (
     SELECT id FROM sites WHERE name LIKE '주소체크테스트 %'
   )" [])
(db_exec DB "DELETE FROM sites WHERE name LIKE '주소체크테스트 %'" [])
(db_exec DB "DELETE FROM customers WHERE name LIKE '주소체크테스트 %'" [])

(defn checklist-items [water-result leak-result]
  [{:item_code "WATER_SUPPLY" :result water-result :note "수압 확인"}
   {:item_code "POWER_WIRING" :result "OK" :note nil}
   {:item_code "PUMP_PRESSURE" :result "OK" :note nil}
   {:item_code "LEAK" :result leak-result :note "배관 확인"}
   {:item_code "FILTER" :result "OK" :note nil}
   {:item_code "CHEMICAL" :result "NOT_APPLICABLE" :note nil}
   {:item_code "SAFETY" :result "OK" :note nil}
   {:item_code "CLEANLINESS" :result "OK" :note nil}])

(let [customer (create-customer "주소체크테스트 고객" "010-1111-2222" nil nil "CUSTOMER" "경기도 양주시")
      customer-id (get customer :id)
      site-a (create-site customer-id "주소체크테스트 양주점" "경기도 양주시 감악산로 1" "031-111-1111")
      site-b (create-site-with-stage customer-id "주소체크테스트 의정부 후보지" "경기도 의정부시 시민로 2" "031-222-2222" "CANDIDATE")
      site-a-id (get site-a :id)
      site-b-id (get site-b :id)
      first-checklist (create-site-checklist
                        site-a-id "2026-07-30" "김기사" "누수 재확인 필요"
                        (checklist-items "OK" "ATTENTION"))]
  (assert (= (get first-checklist :site_id) site-a-id) "체크리스트가 선택한 주소 현장에 연결돼야 한다")
  (assert (= (get first-checklist :site_address) "경기도 양주시 감악산로 1") "체크리스트 상세에 주소가 포함돼야 한다")
  (assert (= (get first-checklist :overall_result) "ATTENTION") "확인 필요 항목이 있으면 종합 결과가 ATTENTION이어야 한다")
  (assert (= (length (get first-checklist :items)) 8) "주소 체크리스트는 정본 8개 항목을 저장해야 한다")
  (assert (= (get (first (get first-checklist :items)) :item_label) "급수 상태") "항목명 스냅샷을 함께 저장해야 한다")
  (assert (= (get site-b :site_stage) "CANDIDATE") "후보지는 운영 현장과 구분해 저장해야 한다")
  (assert (= (get (first (list-customer-sites customer-id)) :id) site-b-id) "고객 현장 목록에서 검토할 후보지를 먼저 보여줘야 한다")
  (assert (= (length (list-site-checklists site-b-id)) 0) "다른 주소의 체크리스트가 섞이면 안 된다")

  (let [second-checklist (create-site-checklist
                           site-a-id "2026-07-31" "박기사" "즉시 조치"
                           (checklist-items "FAIL" "OK"))
        site-a-history (list-site-checklists site-a-id)]
    (assert (= (get second-checklist :overall_result) "FAIL") "이상 항목이 있으면 종합 결과가 FAIL이어야 한다")
    (assert (= (length site-a-history) 2) "같은 주소의 점검 이력을 누적해야 한다")
    (assert (= (get (first site-a-history) :inspected_on) "2026-07-31") "주소 이력은 최신 점검일 순이어야 한다")
    (assert (= (get (first site-a-history) :site_id) site-a-id) "주소 이력은 요청 현장으로 제한돼야 한다"))

  (let [invalid-date
          (try
            (do
              (create-site-checklist site-a-id "2026-02-30" "김기사" nil (checklist-items "OK" "OK"))
              false)
            (catch [e] true))
        missing-items
          (try
            (do
              (create-site-checklist site-a-id "2026-08-01" "김기사" nil
                [{:item_code "WATER_SUPPLY" :result "OK" :note nil}])
              false)
            (catch [e] true))
        duplicate-items
          (try
            (do
              (create-site-checklist site-a-id "2026-08-01" "김기사" nil
                [{:item_code "WATER_SUPPLY" :result "OK" :note nil}
                 {:item_code "WATER_SUPPLY" :result "OK" :note nil}
                 {:item_code "PUMP_PRESSURE" :result "OK" :note nil}
                 {:item_code "LEAK" :result "OK" :note nil}
                 {:item_code "FILTER" :result "OK" :note nil}
                 {:item_code "CHEMICAL" :result "OK" :note nil}
                 {:item_code "SAFETY" :result "OK" :note nil}
                 {:item_code "CLEANLINESS" :result "OK" :note nil}])
              false)
            (catch [e] true))
        invalid-site-stage
          (try
            (do
              (create-site-with-stage customer-id "잘못된 후보지" "서울" nil "UNKNOWN")
              false)
            (catch [e] true))]
    (assert invalid-date "실재하지 않는 점검일은 거부해야 한다")
    (assert missing-items "8개보다 적은 체크 항목은 거부해야 한다")
    (assert duplicate-items "중복 항목 코드는 거부하고 트랜잭션을 롤백해야 한다")
    (assert invalid-site-stage "지원하지 않는 후보지 구분은 거부해야 한다")
    (assert (= (length (list-site-checklists site-a-id)) 2) "실패한 저장은 주소 이력에 남으면 안 된다")))

(println "✓ Site checklist tests passed")
