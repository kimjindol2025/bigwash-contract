(load "/root/apps/bigwash-contract/src/washcare.fl")

;; db/contracts.sqlite는 테스트 간 리셋되지 않는 공유 파일이라, 이 테스트 픽스처를
;; 먼저 정리한다 (FK 순서: outreach_touches/equipment -> sites -> customers).
(db_exec DB
  "DELETE FROM outreach_touches WHERE site_id IN
   (SELECT id FROM sites WHERE name IN ('판매테스트 세차장', '판매테스트 세차장 2호점'))" [])
(db_exec DB "DELETE FROM equipment WHERE serial_number = 'SERIAL-SALE-001'" [])
(db_exec DB "DELETE FROM sites WHERE name IN ('판매테스트 세차장', '판매테스트 세차장 2호점')" [])
(db_exec DB "DELETE FROM customers WHERE name = '판매테스트 점주'" [])

;; 신규 고객으로 판매 등록 — 견적·계약 -> 고객/사업장 -> 장비 -> 장비관리 링크 -> 첫 접촉
(let [result (register-sale
               nil "판매테스트 점주" "010-3333-4444" "sale@example.com"
               "판매테스트 세차장" "서울시 판매구" "02-3333-4444"
               nil
               [{:category "세차기" :model "BW-300" :serial_number "SERIAL-SALE-001"
                 :installed_at "2026-07-17" :warranty_ends_at "2029-07-17"}]
               90)]
  (assert (not (nil? (get result :customer_id))) "신규 고객이 생성돼야 한다")
  (assert (not (nil? (get result :site_id))) "사업장이 생성돼야 한다")
  (assert (= (length (get result :equipment)) 1) "장비가 등록돼야 한다")
  (assert (= (length (get result :site_public_token)) 64) "사업장 공개 토큰은 64자 hex여야 한다")

  (let [site-id (get result :site_id)
        token (get result :site_public_token)]

    ;; 첫 접촉(OutreachTouch)이 자동 예약됐는지 확인
    (let [touches (db_query DB "SELECT * FROM outreach_touches WHERE site_id = ?" [site-id])]
      (assert (= (length touches) 1) "판매 등록 시 첫 접촉이 자동 예약돼야 한다")
      (assert (= (get (first touches) :touch_type) "CHECKIN") "첫 접촉 유형은 CHECKIN이어야 한다"))

    ;; 장비관리 링크로 공개 조회 — 내부 정보(연락처는 공개, 계약금액 등은 없음) 확인
    (let [view (get-site-public-view token "203.0.113.40")]
      (assert (= (get view :site_name) "판매테스트 세차장") "사업장명이 보여야 한다")
      (assert (= (length (get view :equipment)) 1) "등록된 장비 목록이 보여야 한다")
      (assert (= (get (first (get view :equipment)) :model) "BW-300") "장비 모델이 보여야 한다"))

    ;; 폐기 -> 재발급
    (revoke-site-link site-id)
    (assert (nil? (get-site-public-view token "203.0.113.41")) "폐기된 사업장 링크는 404용 nil이어야 한다")

    (let [reissued (reissue-site-link site-id)
          new-token (get reissued :site_public_token)]
      (assert (not (= token new-token)) "재발급 토큰은 이전과 달라야 한다")
      (assert (not (nil? (get-site-public-view new-token "203.0.113.42"))) "재발급 토큰은 즉시 동작해야 한다"))

    ;; 기존 고객으로 두 번째 사업장 판매 등록 (customer-id 재사용)
    (let [customer-id (get result :customer_id)
          result2 (register-sale
                    customer-id nil nil nil
                    "판매테스트 세차장 2호점" "서울시 판매구2" "02-3333-5555"
                    nil [] 90)]
      (assert (= (get result2 :customer_id) customer-id) "기존 고객 ID를 재사용해야 한다"))))

;; 보증 만료 임박 목록 — 30일 이내로 만료되는 장비만 나와야 한다
(db_exec DB
  "DELETE FROM outreach_touches WHERE site_id IN
   (SELECT id FROM sites WHERE name = '만료임박 세차장')" [])
(db_exec DB "DELETE FROM equipment WHERE serial_number = 'SERIAL-EXPIRING-001'" [])
(db_exec DB "DELETE FROM sites WHERE name = '만료임박 세차장'" [])
(db_exec DB "DELETE FROM customers WHERE name = '만료임박 점주'" [])

(let [result (register-sale
               nil "만료임박 점주" "010-4444-5555" ""
               "만료임박 세차장" "서울" "02-4444-5555"
               nil
               [{:category "세차기" :model "BW-400" :serial_number "SERIAL-EXPIRING-001"
                 :installed_at "2023-01-01" :warranty_ends_at "2026-08-01"}]
               90)]
  (let [expiring (filter (fn [e] (= (get e :model) "BW-400")) (list-warranty-expiring 30))]
    (assert (> (length expiring) 0) "30일 이내 만료되는 장비는 목록에 나와야 한다"))
  (let [expiring-1day (filter (fn [e] (= (get e :model) "BW-400")) (list-warranty-expiring 1))]
    (assert (= (length expiring-1day) 0) "1일 이내로 좁히면 8/1 만료 장비는 안 나와야 한다")))

;; 중간 실패 원자성: 장비 UNIQUE 오류가 나면 앞서 만든 고객·사업장·접촉도 남으면 안 된다.
(db_exec DB "DELETE FROM customers WHERE name = '판매롤백 점주'" [])
(let [customers-before (get (first (db_query DB "SELECT COUNT(*) AS count FROM customers" [])) :count)
      sites-before (get (first (db_query DB "SELECT COUNT(*) AS count FROM sites" [])) :count)
      equipment-before (get (first (db_query DB "SELECT COUNT(*) AS count FROM equipment" [])) :count)
      outreach-before (get (first (db_query DB "SELECT COUNT(*) AS count FROM outreach_touches" [])) :count)]
  (try
    (do
      (register-sale
        nil "판매롤백 점주" "010-5555-6666" "rollback@example.com"
      "판매롤백 세차장" "서울" "02-5555-6666"
      nil
      [{:category "세차기" :model "BW-FAIL" :serial_number "SERIAL-SALE-001"
        :installed_at "2026-07-17" :warranty_ends_at "2029-07-17"}]
        90)
      (error "중복 일련번호 판매 등록은 실패해야 한다"))
    (catch [e] true))
  (assert (= (get (first (db_query DB "SELECT COUNT(*) AS count FROM customers" [])) :count)
             customers-before)
    "판매 실패 시 신규 고객이 롤백되어야 한다")
  (assert (= (get (first (db_query DB "SELECT COUNT(*) AS count FROM sites" [])) :count)
             sites-before)
    "판매 실패 시 신규 사업장이 롤백되어야 한다")
  (assert (= (get (first (db_query DB "SELECT COUNT(*) AS count FROM equipment" [])) :count)
             equipment-before)
    "판매 실패 시 장비가 남으면 안 된다")
  (assert (= (get (first (db_query DB "SELECT COUNT(*) AS count FROM outreach_touches" [])) :count)
             outreach-before)
    "판매 실패 시 접촉 예약이 남으면 안 된다"))

(println "✓ Sales flow tests passed")
