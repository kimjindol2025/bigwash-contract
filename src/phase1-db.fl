;;; BigWash Care Phase 1 schema and bounded legacy migration

;; 배포 위치(노드)에 따라 절대경로가 달라지므로 PWD 기준으로 계산한다.
(define REPO-ROOT
  (let [override (env-get "BIGWASH_REPO_ROOT")]
    (if (or (nil? override) (str-blank? override)) (env-get "PWD") override)))

(load (str REPO-ROOT "/src/db.fl"))

;;; 레거시 client_id NOT NULL 컬럼용 임시 롤백 섀도우.
;;; 검증된 레거시 ID는 보존하고, 신규 고객은 음수 Customer.id를 쓴다.
;;; (계약 생성·견적→계약 전환 양쪽에서 공유)
(defn resolve-shadow-client-id [customer-id]
  (let [rows (db_query DB
               "SELECT legacy_client_id FROM customers WHERE id = ?"
               [customer-id])]
    (if (= (length rows) 0) (error "Customer not found"))
    (let [legacy-id (get (first rows) :legacy_client_id)]
      (if (nil? legacy-id) (- 0 customer-id) legacy-id))))

(defn phase1-contract-customer-column? []
  (let [rows (db_query DB
               "SELECT COUNT(*) AS count FROM pragma_table_info('contracts') WHERE name = 'customer_id'"
               [])]
    (> (get (first rows) :count) 0)))

(defn phase1-column-exists? [table-name column-name]
  (let [rows (db_query DB
               "SELECT COUNT(*) AS count FROM pragma_table_info(?) WHERE name = ?"
               [table-name column-name])]
    (> (get (first rows) :count) 0)))

;; 기존 Contract와 WashCare 통합 계약 API가 공유하는 단일 상태전이 정본.
(defn valid-contract-transition? [from to]
  (cond
    [(= from "DRAFT") (or (= to "PENDING") (= to "CANCELLED"))]
    [(= from "PENDING") (or (= to "APPROVED") (= to "CANCELLED"))]
    [(= from "APPROVED") (or (= to "COMPLETED") (= to "CANCELLED"))]
    [true false]))

(defn phase1-create-schema []
  (do
    (db_exec DB "PRAGMA foreign_keys = ON" [])
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS customers (
        id INTEGER PRIMARY KEY,
        name TEXT NOT NULL,
        phone TEXT,
        email TEXT,
        memo TEXT,
        legacy_client_id INTEGER UNIQUE,
        migration_status TEXT NOT NULL DEFAULT 'VERIFIED'
          CHECK (migration_status IN ('VERIFIED', 'NEEDS_REVIEW')),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      )" [])

    (if (not (phase1-contract-customer-column?))
      (do
        (db_exec DB
          "ALTER TABLE contracts ADD COLUMN customer_id INTEGER REFERENCES customers(id)"
          [])
        true)
      true)

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS sites (
        id INTEGER PRIMARY KEY,
        customer_id INTEGER NOT NULL,
        name TEXT NOT NULL,
        address TEXT,
        contact_phone TEXT,
        status TEXT NOT NULL DEFAULT 'ACTIVE'
          CHECK (status IN ('ACTIVE', 'PAUSED', 'CLOSED')),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(customer_id) REFERENCES customers(id)
      )" [])

    ;; 고객관리 1차: 잠재고객 단계에서 사업장 생성이 필수는 아니므로
    ;; 최소 분류/주소 정보는 customers 자체에 둔다.
    (if (not (phase1-column-exists? "customers" "customer_type"))
      (do
        (db_exec DB "ALTER TABLE customers ADD COLUMN customer_type TEXT NOT NULL DEFAULT 'LEAD'" [])
        true)
      true)
    (if (not (phase1-column-exists? "customers" "address"))
      (do
        (db_exec DB "ALTER TABLE customers ADD COLUMN address TEXT" [])
        true)
      true)

    ;; 2026-07-17 추가: "고객에게 장비관리 링크 전달"(9장 판매 흐름) — 티켓 단위가
    ;; 아니라 사업장 단위로 지속되는 링크. 판매 등록 시 한 번 발급한다.
    (if (not (phase1-column-exists? "sites" "public_token_hash"))
      (do
        (db_exec DB "ALTER TABLE sites ADD COLUMN public_token_hash TEXT" [])
        true)
      true)
    (if (not (phase1-column-exists? "sites" "public_token_revoked_at"))
      (do
        (db_exec DB "ALTER TABLE sites ADD COLUMN public_token_revoked_at TEXT" [])
        true)
      true)
    ;; 후보지는 운영 현장과 같은 주소 엔터티·체크리스트 이력을 쓰되 단계만
    ;; 분리한다. 기존 sites 행은 모두 OPERATING으로 안전하게 백필된다.
    (if (not (phase1-column-exists? "sites" "site_stage"))
      (do
        (db_exec DB
          "ALTER TABLE sites ADD COLUMN site_stage TEXT NOT NULL DEFAULT 'OPERATING'
           CHECK (site_stage IN ('CANDIDATE', 'OPERATING', 'REJECTED'))"
          [])
        true)
      true)

    ;; 2026-07-31 추가: 고객의 주소별 현장을 부모로 갖는 점검 체크리스트.
    ;; 한 현장에 여러 점검 이력을 누적하며, 항목명은 저장 당시 스냅샷으로 남겨
    ;; 이후 기본 체크 항목이 바뀌어도 과거 기록의 의미가 변하지 않게 한다.
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS site_checklists (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        inspected_on TEXT NOT NULL,
        inspector TEXT NOT NULL,
        overall_result TEXT NOT NULL DEFAULT 'PASS'
          CHECK (overall_result IN ('PASS', 'ATTENTION', 'FAIL')),
        notes TEXT,
        completed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS site_checklist_items (
        id INTEGER PRIMARY KEY,
        checklist_id INTEGER NOT NULL,
        item_code TEXT NOT NULL,
        item_label TEXT NOT NULL,
        result TEXT NOT NULL
          CHECK (result IN ('OK', 'ATTENTION', 'FAIL', 'NOT_APPLICABLE')),
        note TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(checklist_id) REFERENCES site_checklists(id),
        UNIQUE(checklist_id, item_code)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS equipment (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        contract_id INTEGER,
        category TEXT NOT NULL,
        model TEXT,
        serial_number TEXT UNIQUE,
        installed_at TEXT,
        warranty_ends_at TEXT,
        status TEXT NOT NULL DEFAULT 'ACTIVE'
          CHECK (status IN ('ACTIVE', 'REPAIR', 'RETIRED')),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id),
        FOREIGN KEY(contract_id) REFERENCES contracts(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS service_tickets (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        equipment_id INTEGER,
        symptom TEXT NOT NULL,
        priority TEXT NOT NULL DEFAULT 'NORMAL'
          CHECK (priority IN ('LOW', 'NORMAL', 'HIGH', 'URGENT')),
        source TEXT NOT NULL DEFAULT 'PHONE'
          CHECK (source IN ('PHONE', 'MESSAGE', 'WEB', 'INTERNAL')),
        status TEXT NOT NULL DEFAULT 'RECEIVED'
          CHECK (status IN ('RECEIVED', 'SCHEDULED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED')),
        scheduled_at TEXT,
        closed_at TEXT,
        public_token_hash TEXT UNIQUE,
        public_token_revoked_at TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id),
        FOREIGN KEY(equipment_id) REFERENCES equipment(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS service_visits (
        id INTEGER PRIMARY KEY,
        ticket_id INTEGER NOT NULL,
        technician TEXT NOT NULL,
        visited_at TEXT NOT NULL,
        diagnosis TEXT,
        action_taken TEXT,
        parts_used TEXT,
        labor_cost REAL NOT NULL DEFAULT 0,
        parts_cost REAL NOT NULL DEFAULT 0,
        next_inspection_at TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(ticket_id) REFERENCES service_tickets(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS service_ticket_history (
        id INTEGER PRIMARY KEY,
        ticket_id INTEGER NOT NULL,
        old_status TEXT,
        new_status TEXT NOT NULL,
        changed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(ticket_id) REFERENCES service_tickets(id)
      )" [])

    (db_exec DB
      "CREATE TRIGGER IF NOT EXISTS trg_service_ticket_status_history
       AFTER UPDATE OF status ON service_tickets
       WHEN OLD.status <> NEW.status
       BEGIN
         INSERT INTO service_ticket_history (ticket_id, old_status, new_status)
         VALUES (NEW.id, OLD.status, NEW.status);
       END" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS link_access_logs (
        id INTEGER PRIMARY KEY,
        ticket_id INTEGER,
        token_identifier TEXT NOT NULL,
        ip_address TEXT NOT NULL,
        access_outcome TEXT NOT NULL,
        accessed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(ticket_id) REFERENCES service_tickets(id)
      )" [])

    ;; 2026-07-17 추가: 매출 30%인 부품판매. A/S(service_visits)와 독립적으로도
    ;; 판매될 수 있어야 하므로 ticket_id/equipment_id는 nullable이다.
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS part_sales (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        equipment_id INTEGER,
        ticket_id INTEGER,
        part_name TEXT NOT NULL,
        quantity INTEGER NOT NULL DEFAULT 1,
        unit_price REAL NOT NULL,
        total_price REAL NOT NULL,
        channel TEXT NOT NULL DEFAULT 'STORE'
          CHECK (channel IN ('STORE', 'ONLINE')),
        sold_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id),
        FOREIGN KEY(equipment_id) REFERENCES equipment(id),
        FOREIGN KEY(ticket_id) REFERENCES service_tickets(id)
      )" [])

    ;; 2026-07-17 추가: 판매 후 ~3년 휴면기 동안의 주기적 홍보/관계유지. 이게 실제로
    ;; 가장 자주 도는 흐름이라 next_touch_at 기준 조회가 핵심이다.
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS outreach_touches (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        equipment_id INTEGER,
        touch_type TEXT NOT NULL DEFAULT 'CHECKIN'
          CHECK (touch_type IN ('CHECKIN', 'INSPECTION_REMINDER', 'REPLACEMENT_OFFER', 'PROMOTION')),
        channel TEXT NOT NULL DEFAULT 'PHONE'
          CHECK (channel IN ('PHONE', 'KAKAO', 'SMS', 'EMAIL')),
        sent_at TIMESTAMP,
        response TEXT
          CHECK (response IS NULL OR response IN ('NO_RESPONSE', 'POSITIVE', 'NEGATIVE', 'CONVERTED')),
        converted_to TEXT
          CHECK (converted_to IS NULL OR converted_to IN ('TICKET', 'PART_SALE', 'NEW_EQUIPMENT')),
        converted_ref_id INTEGER,
        next_touch_at TIMESTAMP,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id),
        FOREIGN KEY(equipment_id) REFERENCES equipment(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS consultations (
        id INTEGER PRIMARY KEY,
        customer_id INTEGER NOT NULL,
        consulted_at TEXT NOT NULL,
        method TEXT NOT NULL DEFAULT 'PHONE'
          CHECK (method IN ('PHONE', 'SMS', 'KAKAO', 'VISIT', 'OTHER')),
        content TEXT NOT NULL,
        next_action TEXT NOT NULL DEFAULT 'NONE'
          CHECK (next_action IN ('NONE', 'CALLBACK', 'QUOTE', 'SERVICE_TICKET', 'SALE', 'CONTRACT_REVIEW')),
        next_contact_at TEXT,
        completed_at TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(customer_id) REFERENCES customers(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS customer_contacts (
        id INTEGER PRIMARY KEY,
        customer_id INTEGER NOT NULL,
        name TEXT NOT NULL,
        position TEXT,
        department TEXT,
        phone TEXT,
        email TEXT,
        role TEXT NOT NULL DEFAULT 'OTHER'
          CHECK (role IN ('OWNER','MANAGER','SITE_MANAGER','ACCOUNTING','PURCHASING','FACILITY','OTHER')),
        is_primary INTEGER NOT NULL DEFAULT 0 CHECK (is_primary IN (0,1)),
        status TEXT NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE','INACTIVE')),
        memo TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(customer_id) REFERENCES customers(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS customer_tasks (
        id INTEGER PRIMARY KEY,
        customer_id INTEGER NOT NULL,
        title TEXT NOT NULL,
        due_at TEXT,
        priority TEXT NOT NULL DEFAULT 'NORMAL' CHECK (priority IN ('LOW','NORMAL','HIGH')),
        status TEXT NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING','IN_PROGRESS','DONE','DELAYED','CANCELLED')),
        memo TEXT,
        completed_at TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(customer_id) REFERENCES customers(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS customer_followups (
        id INTEGER PRIMARY KEY,
        customer_id INTEGER NOT NULL,
        followup_type TEXT NOT NULL CHECK (followup_type IN (
          'CONSULT_RECALL','QUOTE_CHECK','INSTALL_CHECK','SERVICE_CHECK','REPAIR_RECHECK',
          'PAYMENT_NOTICE','CONSUMABLE_NOTICE','WARRANTY_END_NOTICE','CARE_PLAN_RENEWAL','LONG_TERM_INACTIVE')),
        scheduled_at TEXT NOT NULL,
        contact_method TEXT CHECK (contact_method IN ('PHONE','SMS','KAKAO','VISIT','OTHER')),
        result TEXT,
        customer_reaction TEXT,
        next_followup_at TEXT,
        completed_at TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(customer_id) REFERENCES customers(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS quotes (
        id INTEGER PRIMARY KEY,
        customer_id INTEGER NOT NULL,
        quote_number TEXT UNIQUE NOT NULL,
        title TEXT NOT NULL,
        amount REAL NOT NULL,
        valid_until TEXT,
        status TEXT NOT NULL DEFAULT 'DRAFT'
          CHECK (status IN ('DRAFT','SENT','REVIEWING','REVISION_REQUESTED','APPROVED','ON_HOLD','REJECTED','CONVERTED')),
        sent_at TEXT,
        contract_id INTEGER,
        memo TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(customer_id) REFERENCES customers(id),
        FOREIGN KEY(contract_id) REFERENCES contracts(id)
      )" [])

    ;; 2026-07-22 추가 (7주차): 통합 계약관리 — 기존 status 5종/전이(DRAFT→
    ;; PENDING→APPROVED→COMPLETED, DRAFT/PENDING/APPROVED→CANCELLED)는 그대로
    ;; 두고, contracts에 idempotent ALTER로 nullable 컬럼만 보강한다. 결제/
    ;; 미수금/PG 상태는 이번에도 넣지 않는다(PaymentOrder 도입 전 원칙 —
    ;; CarePlan/quotes와 동일). site_id/quote_id는 quotes/sites 테이블이 이미
    ;; 생성된 뒤라야 REFERENCES가 의미를 가지므로 이 위치(quotes 다음)에 둔다.
    ;; 각 ALTER는 (if 조건 (do ... true) true) 형태를 명시적으로 갖춘다 — 이
    ;; 파일의 다른 idempotent ALTER들과 동일한 방어 패턴(2026-07-21 수정 커밋
    ;; "FreeLang if-비tail 함정" 참고 — bare 2-arg if를 do 시퀀스 안에 그냥
    ;; 두면 조용히 스킵될 수 있어 반드시 두 분기·명시 반환값을 둔다).
    (if (not (phase1-column-exists? "contracts" "title"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN title TEXT" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "site_id"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN site_id INTEGER REFERENCES sites(id)" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "quote_id"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN quote_id INTEGER REFERENCES quotes(id)" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "contract_date"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN contract_date TEXT" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "work_starts_at"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN work_starts_at TEXT" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "work_ends_at"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN work_ends_at TEXT" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "warranty_ends_at"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN warranty_ends_at TEXT" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "signed_at"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN signed_at TEXT" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "work_scope"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN work_scope TEXT" []) true)
      true)
    (if (not (phase1-column-exists? "contracts" "memo"))
      (do (db_exec DB "ALTER TABLE contracts ADD COLUMN memo TEXT" []) true)
      true)

    ;; 2026-07-21 추가 (4주차): 연간관리(CarePlan). site_id 앵커 — equipment/
    ;; part_sales/outreach_touches와 동일하게 현장 단위로 소비되는 개념이라
    ;; customer_id가 아니라 site_id에 건다(docs/09 4주차 준비 메모). 결제 상태
    ;; 컬럼(payment_status)은 PaymentOrder 도입 전이라 넣지 않는다 — price_snapshot은
    ;; 가입 시점 참고용 스냅샷일 뿐 청구 원장이 아니다.
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS care_plans (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        plan_code TEXT NOT NULL CHECK (plan_code IN ('TRIAL_90', 'BASIC_360', 'FIELD_790')),
        status TEXT NOT NULL DEFAULT 'ACTIVE'
          CHECK (status IN ('ACTIVE', 'CANCELLED', 'RENEWED')),
        starts_at TEXT NOT NULL,
        ends_at TEXT NOT NULL,
        price_snapshot INTEGER NOT NULL CHECK (price_snapshot >= 0),
        included_visits INTEGER NOT NULL DEFAULT 0 CHECK (included_visits >= 0),
        used_visits INTEGER NOT NULL DEFAULT 0
          CHECK (used_visits >= 0 AND used_visits <= included_visits),
        next_inspection_at TEXT,
        renewed_from_id INTEGER,
        memo TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id),
        FOREIGN KEY(renewed_from_id) REFERENCES care_plans(id)
      )" [])

    ;; 2026-07-21 추가: 안드로이드 자동 통화·문자 로거(mobserve)가 보내는
    ;; webhook을 그대로 쌓는 원본 테이블. 모르는 번호(고객 매칭 안 됨)는
    ;; customer_id NULL로 저장 — 나중에 고객 등록되면 소급 연결 가능하도록
    ;; 버리지 않는다(단, 타임라인 UNION에는 customer_id NOT NULL만 노출).
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS call_events (
        id INTEGER PRIMARY KEY,
        customer_id INTEGER,
        phone TEXT NOT NULL,
        event_type TEXT NOT NULL CHECK (event_type IN ('CALL', 'SMS')),
        direction TEXT NOT NULL CHECK (direction IN ('incoming', 'outgoing', 'missed')),
        content TEXT,
        duration_seconds INTEGER,
        occurred_at TEXT NOT NULL,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(customer_id) REFERENCES customers(id)
      )" [])

    ;; 2026-08-01 추가: 세차장 점주용 운영 기록실. 회사 내부 A/S 운영 집계
    ;; (get-ops-summary/get-ops-weekly)와 이름·책임을 섞지 않기 위해 wash_ops_로
    ;; 분리한다. 후보지에서 운영 전환된 동일 sites.id를 계속 부모로 사용한다.
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS wash_ops_daily_records (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        operation_date TEXT NOT NULL,
        opened_at TEXT,
        closed_at TEXT,
        reserved_count INTEGER NOT NULL DEFAULT 0 CHECK (reserved_count >= 0),
        staff_count INTEGER NOT NULL DEFAULT 0 CHECK (staff_count >= 0),
        weather TEXT,
        busiest_period TEXT,
        status TEXT NOT NULL DEFAULT 'NORMAL'
          CHECK (status IN ('NORMAL','CAUTION','PROBLEM')),
        owner_work_minutes INTEGER NOT NULL DEFAULT 0 CHECK (owner_work_minutes >= 0),
        owner_memo TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        UNIQUE(site_id, operation_date),
        FOREIGN KEY(site_id) REFERENCES sites(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS wash_ops_vehicle_jobs (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        job_date TEXT NOT NULL,
        plate_number TEXT NOT NULL,
        vehicle_model TEXT,
        vehicle_size TEXT,
        arrived_at TEXT,
        started_at TEXT,
        finished_at TEXT,
        departed_at TEXT,
        work_minutes INTEGER NOT NULL DEFAULT 0 CHECK (work_minutes >= 0),
        wait_minutes INTEGER NOT NULL DEFAULT 0 CHECK (wait_minutes >= 0),
        base_work TEXT,
        extra_work TEXT,
        assigned_staff TEXT,
        special_contamination TEXT,
        customer_request TEXT,
        return_note TEXT,
        payment_amount REAL NOT NULL DEFAULT 0 CHECK (payment_amount >= 0),
        owner_involved INTEGER NOT NULL DEFAULT 0 CHECK (owner_involved IN (0,1)),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id)
      )" [])

    ;; 차량 상태는 한 JSON 칼럼에 덮어쓰지 않는다. 입고/출차 단계와 외부/내부
    ;; 구역, 정본 점검 코드를 행으로 쌓아 항목별 반복 문제를 집계할 수 있게 한다.
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS wash_ops_vehicle_condition_checks (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        vehicle_job_id INTEGER NOT NULL,
        inspection_stage TEXT NOT NULL DEFAULT 'ARRIVAL'
          CHECK (inspection_stage IN ('ARRIVAL','FINAL')),
        area_group TEXT NOT NULL
          CHECK (area_group IN ('EXTERIOR','INTERIOR')),
        checkpoint_code TEXT NOT NULL,
        checkpoint_label TEXT NOT NULL,
        condition_status TEXT NOT NULL
          CHECK (condition_status IN ('NORMAL','CONTAMINATED','WET_ODOR','DAMAGE','RECHECK','NOT_APPLICABLE')),
        note TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        UNIQUE(vehicle_job_id, inspection_stage, checkpoint_code),
        FOREIGN KEY(site_id) REFERENCES sites(id),
        FOREIGN KEY(vehicle_job_id) REFERENCES wash_ops_vehicle_jobs(id) ON DELETE CASCADE
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS wash_ops_reworks (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        vehicle_job_id INTEGER,
        occurred_date TEXT NOT NULL,
        plate_number TEXT NOT NULL,
        complaint_area TEXT NOT NULL,
        customer_request TEXT,
        initial_worker TEXT,
        inspector TEXT,
        free_minutes INTEGER NOT NULL DEFAULT 0 CHECK (free_minutes >= 0),
        cause TEXT NOT NULL CHECK (cause IN (
          'REQUEST_MISSED','WORK_STEP_MISSED','INSPECTION_MISSED','TIME_SHORTAGE',
          'EXTRA_CONTAMINATION','EQUIPMENT','EXPLANATION_MISMATCH','OTHER')),
        result TEXT,
        prevention_action TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id),
        FOREIGN KEY(vehicle_job_id) REFERENCES wash_ops_vehicle_jobs(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS wash_ops_equipment_issues (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        equipment_id INTEGER,
        occurred_date TEXT NOT NULL,
        issue_title TEXT NOT NULL,
        state TEXT NOT NULL DEFAULT 'OBSERVE'
          CHECK (state IN ('OBSERVE','STOPPED','REPAIR_REQUESTED','RESOLVED')),
        downtime_minutes INTEGER NOT NULL DEFAULT 0 CHECK (downtime_minutes >= 0),
        action_taken TEXT,
        note TEXT,
        resolved_at TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id),
        FOREIGN KEY(equipment_id) REFERENCES equipment(id)
      )" [])

    (db_exec DB
      "CREATE TABLE IF NOT EXISTS wash_ops_notes (
        id INTEGER PRIMARY KEY,
        site_id INTEGER NOT NULL,
        note_date TEXT NOT NULL,
        content TEXT NOT NULL,
        category TEXT NOT NULL DEFAULT 'UNSORTED'
          CHECK (category IN ('UNSORTED','STAFF','EQUIPMENT','FLOW','CUSTOMER','PRICE','BOOKING','REWORK','IDEA')),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(site_id) REFERENCES sites(id)
      )" [])

    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_contracts_customer_id ON contracts(customer_id)" [])
    ;; 7주차 통합 계약관리 목록 필터(status/site_id)용.
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_contracts_status ON contracts(status)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_contracts_site_id ON contracts(site_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_sites_customer_id ON sites(customer_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_site_checklists_site_date ON site_checklists(site_id, inspected_on DESC, id DESC)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_site_checklist_items_checklist_id ON site_checklist_items(checklist_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_equipment_site_id ON equipment(site_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_tickets_site_status ON service_tickets(site_id, status)" [])
    ;; 2026-07-21 추가: 운영 대시보드 집계(지연·일정미정·오늘방문)가 status+scheduled_at
    ;; 조합으로 조회하므로(docs/09 2주차) 전용 인덱스를 둔다.
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_tickets_status_scheduled ON service_tickets(status, scheduled_at)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_visits_ticket_id ON service_visits(ticket_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_link_logs_token_time ON link_access_logs(token_identifier, accessed_at)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_link_logs_ip_time ON link_access_logs(ip_address, accessed_at)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_part_sales_site_id ON part_sales(site_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_outreach_site_id ON outreach_touches(site_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_outreach_next_touch ON outreach_touches(next_touch_at)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_consultations_customer_id ON consultations(customer_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_consultations_next_contact_at ON consultations(next_contact_at)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_customer_contacts_customer_id ON customer_contacts(customer_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_customer_tasks_customer_id ON customer_tasks(customer_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_customer_followups_customer_id ON customer_followups(customer_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_quotes_customer_id ON quotes(customer_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_care_plans_site_id ON care_plans(site_id)" [])
    ;; 만료 임박/파생 effective_status 조회가 status+ends_at 조합을 쓴다
    ;; (2~3주차 idx_tickets_status_scheduled와 동일한 이유).
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_care_plans_status_ends_at ON care_plans(status, ends_at)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_call_events_customer_id ON call_events(customer_id)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_call_events_phone ON call_events(phone)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_wash_ops_daily_site_date ON wash_ops_daily_records(site_id, operation_date)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_wash_ops_vehicle_site_date ON wash_ops_vehicle_jobs(site_id, job_date)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_wash_ops_vehicle_condition_job ON wash_ops_vehicle_condition_checks(vehicle_job_id, inspection_stage, area_group)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_wash_ops_rework_site_date ON wash_ops_reworks(site_id, occurred_date)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_wash_ops_issue_site_date ON wash_ops_equipment_issues(site_id, occurred_date)" [])
    (db_exec DB "CREATE INDEX IF NOT EXISTS idx_wash_ops_note_site_date ON wash_ops_notes(site_id, note_date)" [])
    (db_exec DB
      "CREATE UNIQUE INDEX IF NOT EXISTS idx_sites_public_token_hash
       ON sites(public_token_hash) WHERE public_token_hash IS NOT NULL" [])))

(defn phase1-backfill-legacy-customers []
  (do
    (db_exec DB
      "INSERT OR IGNORE INTO customers (name, legacy_client_id, migration_status)
       SELECT '레거시 고객-' || client_id, client_id, 'NEEDS_REVIEW'
       FROM contracts
       WHERE client_id IS NOT NULL
       GROUP BY client_id"
      [])
    (db_exec DB
      "UPDATE contracts
       SET customer_id = (
         SELECT customers.id FROM customers
         WHERE customers.legacy_client_id = contracts.client_id
       )
       WHERE customer_id IS NULL"
      [])))

(defn phase1-assert-migration []
  (let [unmapped (db_query DB
                   "SELECT COUNT(*) AS count FROM contracts WHERE customer_id IS NULL"
                   [])
        orphaned (db_query DB
                   "SELECT COUNT(*) AS count
                    FROM contracts c
                    LEFT JOIN customers u ON u.id = c.customer_id
                    WHERE c.customer_id IS NOT NULL AND u.id IS NULL"
                   [])]
    (if (> (get (first unmapped) :count) 0)
      (error "Phase 1 migration failed: unmapped contracts remain"))
    (if (> (get (first orphaned) :count) 0)
      (error "Phase 1 migration failed: orphaned customer references remain"))
    true))

(defn init-phase1-db []
  (do
    (db_exec DB "BEGIN TRANSACTION" [])
    (try
      (do
        (phase1-create-schema)
        (phase1-backfill-legacy-customers)
        (phase1-assert-migration)
        (db_exec DB "COMMIT" [])
        true)
      (catch [e]
        (db_exec DB "ROLLBACK" [])
        (error (str "Phase 1 database initialization failed: " e))))))

(init-phase1-db)
