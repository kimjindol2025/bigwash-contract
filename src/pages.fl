;;; 페이지 렌더링 시스템

(load "/root/apps/bigwash-contract/src/ui.fl")

;;; 공통 헤더
(defn render-header []
  (str
    "<header class='header'>"
    "<div class='header-container'>"
    "<div class='logo-section'>"
    "<div class='logo'>"
    "<span class='logo-icon'>⚡</span>"
    "<span class='logo-text'>BigWash</span>"
    "</div>"
    "<span class='logo-subtext'>계약관리</span>"
    "</div>"
    "<nav class='nav'>"
    "<a href='/' class='nav-link'>계약서 관리</a>"
    "<a href='/estimate' class='nav-link'>거래명세서</a>"
    "<a href='/review/phase0' class='nav-link'>검수 트리</a>"
    "<a href='/settings' class='nav-link'>설정</a>"
    "</nav>"
    "<div class='user-section'>"
    "<button class='notification-btn'>"
    "<span class='notification-icon'>🔔</span>"
    "<span class='badge'>2</span>"
    "</button>"
    "<div class='user-avatar'>KC</div>"
    "</div>"
    "</div>"
    "</header>"))

;;; 대시보드 페이지
(defn render-dashboard [contracts]
  (let [[header (render-header)]
        [stats-html (str
          (stat-card "진행 중" "12" "+2" "orange")
          (stat-card "서명 대기" "5" "" "warning")
          (stat-card "완료" "127" "+8" "success")
          (stat-card "금월 계약액" "₩45.2M" "+12%" "orange")
        )]
        [table-rows (apply str (map contract-row contracts))]]
    (page "계약서 관리 - BigWash"
      (str
        header
        "<main class='main-content'>"
        "<div class='dashboard-container'>"
        "<div class='action-bar'>"
        "<div>"
        "<h1 class='page-title'>계약서 관리</h1>"
        "<p class='page-subtitle'>2026년 4월 기준</p>"
        "</div>"
        "<button class='btn-primary' hx-get='/contract/new' hx-target='#main'>"
        "<span class='btn-icon'>+</span> 새 계약서 작성"
        "</button>"
        "</div>"
        "<div class='stats-grid'>" stats-html "</div>"
        "<div class='list-section'>"
        "<h2 class='section-title'>최근 계약서</h2>"
        "<div class='contract-table'>"
        "<div class='table-header'>"
        "<div class='col-id'>계약번호</div>"
        "<div class='col-client'>거래처</div>"
        "<div class='col-type'>계약유형</div>"
        "<div class='col-amount'>계약액</div>"
        "<div class='col-status'>상태</div>"
        "<div class='col-date'>계약일</div>"
        "<div class='col-action'>작업</div>"
        "</div>"
        table-rows
        "</div>"
        "</div>"
        "</div>"
        "</main>"
      ))))

;;; 신규 계약서 작성 페이지
(defn render-new-contract []
  (let [[header (render-header)]]
    (page "새 계약서 작성 - BigWash"
      (str
        header
        "<main class='main-content'>"
        "<div class='form-container'>"
        "<div class='form-header'>"
        "<h1 class='page-title'>새 계약서 작성</h1>"
        "<p class='page-subtitle'>계약 정보를 입력하세요</p>"
        "</div>"
        "<form class='form' hx-post='/api/contracts' hx-target='#main'>"
        "<section class='form-section'>"
        "<h2 class='section-title'>계약 유형</h2>"
        "<div class='type-selector'>"
        "<label class='type-option'>"
        "<input type='radio' name='type' value='supply' checked />"
        "<span class='type-option-label'>"
        "<span class='type-icon'>📦</span>"
        "<span>장비공급</span>"
        "</span>"
        "</label>"
        "<label class='type-option'>"
        "<input type='radio' name='type' value='install' />"
        "<span class='type-option-label'>"
        "<span class='type-icon'>🔧</span>"
        "<span>설치시공</span>"
        "</span>"
        "</label>"
        "<label class='type-option'>"
        "<input type='radio' name='type' value='maintenance' />"
        "<span class='type-option-label'>"
        "<span class='type-icon'>🛠️</span>"
        "<span>유지보수</span>"
        "</span>"
        "</label>"
        "<label class='type-option'>"
        "<input type='radio' name='type' value='repair' />"
        "<span class='type-option-label'>"
        "<span class='type-icon'>⚙️</span>"
        "<span>수리</span>"
        "</span>"
        "</label>"
        "</div>"
        "</section>"
        "<section class='form-section'>"
        "<h2 class='section-title'>거래처 정보</h2>"
        "<div class='form-grid'>"
        (form-group "거래처명 *"
          (form-input "clientName" "(주)세차마을 서울지점" ""))
        (form-date "contractDate" "계약일 *" (str (now_ms)))
        "</div>"
        "</section>"
        "<div class='form-actions'>"
        "<button type='button' class='btn-secondary' hx-get='/' hx-target='#main'>취소</button>"
        "<button type='submit' class='btn-primary'>계약서 생성</button>"
        "</div>"
        "</form>"
        "</div>"
        "</main>"
      ))))

;;; 계약서 상세 페이지
(defn render-contract-detail [contract]
  (let [[header (render-header)]
        [id (get contract :id)]
        [client (get contract :client)]
        [type (get contract :type)]
        [amount (get contract :amount)]
        [status (get contract :status)]
        [items (get contract :items)]]
    (page (str id " - BigWash")
      (str
        header
        "<main class='main-content'>"
        "<div class='detail-container'>"
        "<div class='detail-header'>"
        "<div class='detail-header-left'>"
        "<h1 class='detail-title'>" id "</h1>"
        (if (= status "signed")
          "<span class='status-complete-sm'>✓ 서명완료</span>"
          "")
        "</div>"
        "<div class='detail-actions'>"
        "<button class='btn-secondary'>PDF 다운로드</button>"
        "<button class='btn-secondary'>공유</button>"
        "</div>"
        "</div>"
        "<div class='detail-content'>"
        "<div class='detail-left'>"
        "<div class='info-card'>"
        "<h3 class='info-card-title'>거래처 정보</h3>"
        "<div class='info-row'>"
        "<span class='info-label'>거래처명</span>"
        "<span class='info-value'>" (if client client "정보없음") "</span>"
        "</div>"
        "<div class='info-row'>"
        "<span class='info-label'>계약유형</span>"
        "<span class='info-value'>" (if type type "정보없음") "</span>"
        "</div>"
        "</div>"
        "</div>"
        "<div class='detail-right'>"
        "<div class='items-detail-table'>"
        "<div class='table-header'>"
        "<div class='col-name'>품명/사양</div>"
        "<div class='col-amount'>금액</div>"
        "</div>"
        (if items
          (apply str (map (fn [item]
            (str
              "<div class='table-row'>"
              "<div class='col-name'>" (get item :description) "</div>"
              "<div class='col-amount'>₩" (get item :subtotal) "</div>"
              "</div>"))
            items))
          "<div class='table-row'><div class='col-name'>항목 없음</div></div>")
        "</div>"
        "<div class='amount-detail-card'>"
        "<div class='amount-detail-row'>"
        "<span>합계</span>"
        "<span class='amount'>" (if amount amount "₩0") "</span>"
        "</div>"
        "</div>"
        "</div>"
        "</div>"
        "</div>"
        "</main>"
      ))))

;;; Helper: 날짜 입력 폼
(defn form-date [name label value]
  (str
    "<div class='form-group'>"
    "<label class='form-label'>" label "</label>"
    "<input type='date' name='" name "' class='form-input' value='" value "' />"
    "</div>"))

;;; Phase 0 검수 트리 페이지
(defn render-phase0-review-tree []
  (let [[header (render-header)]]
    (page "Phase 0 검수 트리 - BigWash"
      (str
        header
        "<main class='main-content'>"
        "<div class='review-shell'>"
        "<section class='review-hero'>"
        "<div class='review-eyebrow'>Runbook Review Tree</div>"
        "<div class='review-title-row'>"
        "<div>"
        "<h1 class='review-title'>Phase 0 검수 결과를 AFJ 트리 페이지로 옮긴 화면</h1>"
        "<p class='review-subtitle'>"
        "03-phase0-validation-runbook.md 검수 결과를 루트 판단과 세 갈래 이슈로 재구성했다. "
        "문서 상태 충돌, 1인 운영 예외 불일치, 증거 기준 약점을 한 화면에서 따라갈 수 있게 했다."
        "</p>"
        "</div>"
        "<div class='review-meta'>"
        "<span class='review-badge'>검수일 2026-07-19</span>"
        "<span class='review-badge'>핵심 이슈 3건</span>"
        "<span class='review-badge'>AFJ 서버 렌더링</span>"
        "</div>"
        "</div>"
        "</section>"
        "<div class='review-grid'>"
        "<section class='review-panel'>"
        "<h2 class='review-section-title'>리뷰 트리</h2>"
        "<p class='review-section-lead'>"
        "루트 결론은 하나다. 이 문서는 보류된 참고본과 실행형 런북이 섞여 있어 현재 기준 문서로 오해될 수 있다."
        "</p>"
        "<div class='review-tree'>"
        "<div class='review-tree-item root'>"
        "<article class='review-card'>"
        "<div class='review-card-header'>"
        "<span class='review-index'>R</span>"
        "<span class='review-label'>Root 판단</span>"
        "</div>"
        "<div class='review-card-body'>"
        "<p><strong>현재 문서는 참고용 보존본과 실행 지시문이 섞인 상태</strong>라서, 나중 실행자가 기준 문서로 오독하기 쉽다.</p>"
        "<div class='review-quote'>우선 정리 순서는 상태 분리, 예외 경로 반영, 증거 기준 강화다.</div>"
        "</div>"
        "</article>"
        "<div class='review-tree-children'>"
        "<div class='review-tree-item'>"
        "<article class='review-card'>"
        "<div class='review-card-header'>"
        "<span class='review-index'>1</span>"
        "<span class='review-label'>보류 선언과 실행 지시가 한 문서에 같이 살아 있음</span>"
        "<span class='review-severity high'>high risk</span>"
        "</div>"
        "<div class='review-card-body'>"
        "<p>문서 상단은 2026-07-16에 이 런북 실행을 건너뛰고 Phase 1로 바로 진행했다고 말하지만, 아래 본문은 여전히 T 일정과 Go/No-Go 절차를 현재형으로 지시한다.</p>"
        "<div class='review-quote'><strong>영향</strong><br>참고용 보존본인지, 지금 따라야 할 런북인지 구분이 무너진다.</div>"
        "<ul class='review-list'>"
        "<li>03-phase0-validation-runbook.md:6-8</li>"
        "<li>03-phase0-validation-runbook.md:43-49</li>"
        "<li>03-phase0-validation-runbook.md:123-142</li>"
        "<li>01-product-payment-marketing-plan.md:363-368</li>"
        "</ul>"
        "<p><strong>정리 방향</strong><br>상단에 참고용 / 미실행 상태를 더 강하게 표시하고, 본문 일정과 게이트는 비활성 블록으로 분리하는 편이 맞다.</p>"
        "</div>"
        "</article>"
        "</div>"
        "<div class='review-tree-item'>"
        "<article class='review-card'>"
        "<div class='review-card-header'>"
        "<span class='review-index'>2</span>"
        "<span class='review-label'>1인 운영 예외를 허용했지만 완료 조건은 2명 인터뷰 전제임</span>"
        "<span class='review-severity medium'>medium risk</span>"
        "</div>"
        "<div class='review-card-body'>"
        "<p>직원이 없으면 본인이 직접 흐름을 정리하는 대체 경로를 허용하지만, 단계 제목과 산출물은 계속 내부 담당자 2명 인터뷰를 기준으로 남아 있다.</p>"
        "<div class='review-quote'><strong>영향</strong><br>1인 사업자 기준에서는 예외가 허용된 듯 보이지만, 게이트 문구상 통과 정의가 비어 있다.</div>"
        "<ul class='review-list'>"
        "<li>03-phase0-validation-runbook.md:32-33</li>"
        "<li>03-phase0-validation-runbook.md:63-73</li>"
        "<li>03-phase0-validation-runbook.md:131</li>"
        "</ul>"
        "<p><strong>정리 방향</strong><br>2명 인터뷰 또는 1인 자기 업무 분해로 제목, 완료 조건, 최종 게이트를 같이 수정해야 일관성이 생긴다.</p>"
        "</div>"
        "</article>"
        "</div>"
        "<div class='review-tree-item'>"
        "<article class='review-card'>"
        "<div class='review-card-header'>"
        "<span class='review-index'>3</span>"
        "<span class='review-label'>증거 기반 검증인데 `증거 없음`만으로도 완료 처리될 여지가 있음</span>"
        "<span class='review-severity medium'>medium risk</span>"
        "</div>"
        "<div class='review-card-body'>"
        "<p>목적은 네 가지를 증거로 확인하는 것인데, A/S 20건 분석 완료 조건은 각 행에 증거 참조 또는 증거 없음 표시만 있으면 형식상 통과할 수 있다.</p>"
        "<div class='review-quote'><strong>영향</strong><br>증거 부족 사례가 많아도 상위 문제 집계가 만들어질 수 있어 후속 판단의 신뢰도가 낮아진다.</div>"
        "<ul class='review-list'>"
        "<li>03-phase0-validation-runbook.md:12-17</li>"
        "<li>03-phase0-validation-runbook.md:57-61</li>"
        "</ul>"
        "<p><strong>정리 방향</strong><br>증거 없는 사례는 별도 보류로 묶거나, 최소 증거 확보 비율을 완료 조건에 추가하는 편이 안전하다.</p>"
        "</div>"
        "</article>"
        "</div>"
        "</div>"
        "</div>"
        "</section>"
        "<aside class='review-panel review-side-panel'>"
        "<h2 class='review-section-title'>옆가지 요약</h2>"
        "<p class='review-section-lead'>실행 판단에 필요한 요점만 오른쪽에 따로 모았다.</p>"
        "<div class='review-summary-card'>"
        "<span class='review-summary-label'>문서 성격</span>"
        "<p>보류된 런북과 살아 있는 실행 절차가 섞여 있어 상태 분리가 먼저 필요함</p>"
        "</div>"
        "<div class='review-summary-card'>"
        "<span class='review-summary-label'>가장 큰 리스크</span>"
        "<p>나중 실행자가 이 문서를 현재 기준 문서로 오독할 가능성</p>"
        "</div>"
        "<div class='review-summary-card'>"
        "<span class='review-summary-label'>권장 정리 순서</span>"
        "<p>상태 분리 → 1인 예외 반영 → 증거 기준 강화</p>"
        "</div>"
        "<h2 class='review-section-title review-ref-title'>참조 파일</h2>"
        "<a class='review-ref-link' href='/docs/03-phase0-validation-runbook.md'>"
        "<strong>03-phase0-validation-runbook.md</strong>"
        "<span>검수 대상 문서</span>"
        "</a>"
        "<a class='review-ref-link' href='/docs/01-product-payment-marketing-plan.md'>"
        "<strong>01-product-payment-marketing-plan.md</strong>"
        "<span>상위 결정 문서, 13장 비교 기준</span>"
        "</a>"
        "</aside>"
        "</div>"
        "</div>"
        "</main>"))))
