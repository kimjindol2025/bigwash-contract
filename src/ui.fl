;;; UI 컴포넌트 시스템

;;; HTML 속성을 문자열로 변환
(defn attrs->str [attrs]
  (if (nil? attrs)
    ""
    (let [[parts (reduce
      (fn [acc key]
        (push acc (str key "=\"" (get attrs key) "\"")))
      []
      (keys attrs))]]
      (if (= (length parts) 0)
        ""
        (str " " (join parts " "))))))

;;; 스타일 객체를 CSS 문자열로
(defn style-str [style-obj]
  (if (nil? style-obj)
    ""
    (let [[pairs (reduce
      (fn [acc key]
        (push acc (str key ":" (get style-obj key))))
      []
      (keys style-obj))]]
      (join pairs ";"))))

;;; 기본 HTML 요소들
;;; 주의: 이 FreeLang v11.5.1 런타임은 `defn`의 `[attrs & children]` 가변 인자를
;;; 진짜 배열로 모으지 않는다 — `&`가 그냥 이름 있는 고정 파라미터로 처리되고
;;; 선언된 파라미터 개수를 넘는 나머지 인자는 조용히 버려진다(직접 재현 확인,
;;; docs/AI_REFERENCE.md의 "args는 배열" 설명과 실제 동작이 다름). 그래서
;;; children은 항상 호출부에서 `[...]` 배열 리터럴로 명시적으로 넘긴다.
(defn div [attrs children]
  (str "<div" (attrs->str attrs) ">"
       (join children "")
       "</div>"))

(defn header [attrs children]
  (str "<header" (attrs->str attrs) ">"
       (join children "")
       "</header>"))

(defn nav [attrs children]
  (str "<nav" (attrs->str attrs) ">"
       (join children "")
       "</nav>"))

(defn h1 [content]
  (str "<h1>" content "</h1>"))

(defn h2 [content]
  (str "<h2>" content "</h2>"))

(defn h3 [content]
  (str "<h3>" content "</h3>"))

(defn p [content]
  (str "<p>" content "</p>"))

(defn span [attrs content]
  (str "<span" (attrs->str attrs) ">" content "</span>"))

(defn a [attrs content]
  (str "<a" (attrs->str attrs) ">" content "</a>"))

(defn button [attrs content]
  (str "<button" (attrs->str attrs) ">" content "</button>"))

(defn input [attrs]
  (str "<input" (attrs->str attrs) "/>"))

(defn form [attrs children]
  (str "<form" (attrs->str attrs) ">"
       (join children "")
       "</form>"))

(defn table [attrs children]
  (str "<table" (attrs->str attrs) ">"
       (join children "")
       "</table>"))

(defn thead [children]
  (str "<thead>" (join children "") "</thead>"))

(defn tbody [children]
  (str "<tbody>" (join children "") "</tbody>"))

(defn tr [attrs children]
  (str "<tr" (attrs->str attrs) ">"
       (join children "")
       "</tr>"))

(defn th [attrs content]
  (str "<th" (attrs->str attrs) ">" content "</th>"))

(defn td [attrs content]
  (str "<td" (attrs->str attrs) ">" content "</td>"))

;;; 상태 배지
(defn status-badge [status]
  (let [[label (if (= status "draft") "작성중"
                    (if (= status "pending") "승인대기"
                    (if (= status "approved") "승인됨"
                    (if (= status "completed") "완료"
                    status))))]
        [color-class (if (= status "draft") "status-draft"
                    (if (= status "pending") "status-pending"
                    (if (= status "approved") "status-approved"
                    (if (= status "completed") "status-completed"
                    "status-default"))))]]
    (str "<span class=\"status-badge " color-class "\">" label "</span>")))

;;; 통계 카드
(defn stat-card [label value change color]
  (div {:class "stat-card"}
    [(h3 label)
     (div {:class "stat-value"} [value])
     (div {:class "stat-change" :style (str "color:" color)}
       [(span {:class "change-indicator"} (if (>= (str-to-num (str-replace change "%" "")) 0) "↑" "↓"))
        (span {} change)])]))

;;; 계약서 행
(defn contract-row [contract]
  (tr {:class "contract-row"}
    [(td {:class "col-id"} (html-escape (get contract :id)))
     (td {:class "col-client"} (html-escape (get contract :client)))
     (td {:class "col-type"} (html-escape (get contract :type)))
     (td {:class "col-amount"} (html-escape (get contract :amount)))
     (td {:class "col-status"} (status-badge (get contract :status)))
     (td {:class "col-date"} (html-escape (get contract :date)))
     (td {:class "col-actions"}
       (a {:href (str "/contract/" (get contract :id))
           :hx-get (str "/contract/" (get contract :id))
           :hx-target "#main"}
         "상세보기"))]))

;;; 폼 그룹
(defn form-group [label content]
  (div {:class "form-group"}
    [(div {:class "form-label"} [label])
     content]))

;;; 폼 입력
(defn form-input [name placeholder value type]
  (input {:type type
          :name name
          :class "form-input"
          :placeholder placeholder
          :value value}))

;;; 페이지 래퍼
(defn page [title content]
  (str "<!DOCTYPE html>"
       "<html lang=\"ko\">"
       "<head>"
       "<meta charset=\"UTF-8\">"
       "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">"
       "<title>" title "</title>"
       "<link rel=\"stylesheet\" href=\"/styles.css\">"
       "<script src=\"https://unpkg.com/htmx.org@1.9.10\"></script>"
       "</head>"
       "<body>"
       content
       "</body>"
       "</html>"))

;;; Phase 0 검수 트리 — hero 섹션. review-server.fl(단독 서버)과
;;; pages.fl(render-phase0-review-tree)이 제목/부제/세번째 배지만 다르게 공유한다.
(defn render-phase0-review-hero [title subtitle badge3]
  (str
    "<section class='review-hero'>"
    "<div class='review-eyebrow'>Runbook Review Tree</div>"
    "<div class='review-title-row'>"
    "<div>"
    "<h1 class='review-title'>" title "</h1>"
    "<p class='review-subtitle'>" subtitle "</p>"
    "</div>"
    "<div class='review-meta'>"
    "<span class='review-badge'>검수일 2026-07-19</span>"
    "<span class='review-badge'>핵심 이슈 3건</span>"
    "<span class='review-badge'>" badge3 "</span>"
    "</div>"
    "</div>"
    "</section>"))

;;; Phase 0 검수 트리 — 본문(리뷰 트리 + 요약 카드). review-server.fl과
;;; pages.fl 양쪽에서 완전히 동일했던 150줄+ HTML 블록을 여기 하나로 합쳤다.
;;; extra-aside는 요약 카드 뒤에 덧붙일 선택적 HTML(pages.fl의 "참조 파일" 링크용).
(defn render-phase0-review-grid [extra-aside]
  (str
    "<div class='review-grid'>"
    "<section class='review-panel'>"
    "<h2 class='review-section-title'>리뷰 트리</h2>"
    "<p class='review-section-lead'>"
    "루트 결론은 하나다. 이 문서는 보류된 참고본과 실행형 런북이 섞여 있어 현재 기준 문서로 오해될 수 있다."
    "</p>"
    "<div class='review-tree'>"
    "<div class='review-tree-item root'>"
    "<article class='review-card'>"
    "<div class='review-card-header'>"
    "<span class='review-index'>R</span>"
    "<span class='review-label'>Root 판단</span>"
    "</div>"
    "<div class='review-card-body'>"
    "<p><strong>현재 문서는 참고용 보존본과 실행 지시문이 섞인 상태</strong>라서, 나중 실행자가 기준 문서로 오독하기 쉽다.</p>"
    "<div class='review-quote'>우선 정리 순서는 상태 분리, 예외 경로 반영, 증거 기준 강화다.</div>"
    "</div>"
    "</article>"
    "<div class='review-tree-children'>"
    "<div class='review-tree-item'>"
    "<article class='review-card'>"
    "<div class='review-card-header'>"
    "<span class='review-index'>1</span>"
    "<span class='review-label'>보류 선언과 실행 지시가 한 문서에 같이 살아 있음</span>"
    "<span class='review-severity high'>high risk</span>"
    "</div>"
    "<div class='review-card-body'>"
    "<p>문서 상단은 2026-07-16에 이 런북 실행을 건너뛰고 Phase 1로 바로 진행했다고 말하지만, 아래 본문은 여전히 T 일정과 Go/No-Go 절차를 현재형으로 지시한다.</p>"
    "<div class='review-quote'><strong>영향</strong><br>참고용 보존본인지, 지금 따라야 할 런북인지 구분이 무너진다.</div>"
    "<ul class='review-list'>"
    "<li>03-phase0-validation-runbook.md:6-8</li>"
    "<li>03-phase0-validation-runbook.md:43-49</li>"
    "<li>03-phase0-validation-runbook.md:123-142</li>"
    "<li>01-product-payment-marketing-plan.md:363-368</li>"
    "</ul>"
    "<p><strong>정리 방향</strong><br>상단에 참고용 / 미실행 상태를 더 강하게 표시하고, 본문 일정과 게이트는 비활성 블록으로 분리하는 편이 맞다.</p>"
    "</div>"
    "</article>"
    "</div>"
    "<div class='review-tree-item'>"
    "<article class='review-card'>"
    "<div class='review-card-header'>"
    "<span class='review-index'>2</span>"
    "<span class='review-label'>1인 운영 예외를 허용했지만 완료 조건은 2명 인터뷰 전제임</span>"
    "<span class='review-severity medium'>medium risk</span>"
    "</div>"
    "<div class='review-card-body'>"
    "<p>직원이 없으면 본인이 직접 흐름을 정리하는 대체 경로를 허용하지만, 단계 제목과 산출물은 계속 내부 담당자 2명 인터뷰를 기준으로 남아 있다.</p>"
    "<div class='review-quote'><strong>영향</strong><br>1인 사업자 기준에서는 예외가 허용된 듯 보이지만, 게이트 문구상 통과 정의가 비어 있다.</div>"
    "<ul class='review-list'>"
    "<li>03-phase0-validation-runbook.md:32-33</li>"
    "<li>03-phase0-validation-runbook.md:63-73</li>"
    "<li>03-phase0-validation-runbook.md:131</li>"
    "</ul>"
    "<p><strong>정리 방향</strong><br>2명 인터뷰 또는 1인 자기 업무 분해로 제목, 완료 조건, 최종 게이트를 같이 수정해야 일관성이 생긴다.</p>"
    "</div>"
    "</article>"
    "</div>"
    "<div class='review-tree-item'>"
    "<article class='review-card'>"
    "<div class='review-card-header'>"
    "<span class='review-index'>3</span>"
    "<span class='review-label'>증거 기반 검증인데 `증거 없음`만으로도 완료 처리될 여지가 있음</span>"
    "<span class='review-severity medium'>medium risk</span>"
    "</div>"
    "<div class='review-card-body'>"
    "<p>목적은 네 가지를 증거로 확인하는 것인데, A/S 20건 분석 완료 조건은 각 행에 증거 참조 또는 증거 없음 표시만 있으면 형식상 통과할 수 있다.</p>"
    "<div class='review-quote'><strong>영향</strong><br>증거 부족 사례가 많아도 상위 문제 집계가 만들어질 수 있어 후속 판단의 신뢰도가 낮아진다.</div>"
    "<ul class='review-list'>"
    "<li>03-phase0-validation-runbook.md:12-17</li>"
    "<li>03-phase0-validation-runbook.md:57-61</li>"
    "</ul>"
    "<p><strong>정리 방향</strong><br>증거 없는 사례는 별도 보류로 묶거나, 최소 증거 확보 비율을 완료 조건에 추가하는 편이 안전하다.</p>"
    "</div>"
    "</article>"
    "</div>"
    "</div>"
    "</div>"
    "</section>"
    "<aside class='review-panel review-side-panel'>"
    "<h2 class='review-section-title'>옆가지 요약</h2>"
    "<p class='review-section-lead'>실행 판단에 필요한 요점만 오른쪽에 따로 모았다.</p>"
    "<div class='review-summary-card'>"
    "<span class='review-summary-label'>문서 성격</span>"
    "<p>보류된 런북과 살아 있는 실행 절차가 섞여 있어 상태 분리가 먼저 필요함</p>"
    "</div>"
    "<div class='review-summary-card'>"
    "<span class='review-summary-label'>가장 큰 리스크</span>"
    "<p>나중 실행자가 이 문서를 현재 기준 문서로 오독할 가능성</p>"
    "</div>"
    "<div class='review-summary-card'>"
    "<span class='review-summary-label'>권장 정리 순서</span>"
    "<p>상태 분리 → 1인 예외 반영 → 증거 기준 강화</p>"
    "</div>"
    (if (nil? extra-aside) "" extra-aside)
    "</aside>"
    "</div>"))
