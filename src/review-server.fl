;;; Phase 0 Review Tree Standalone Server

(load "/root/kim/bigwash-contract/src/ui.fl")

(define REVIEW-STYLES (file_read "/root/kim/bigwash-contract/public/styles.css"))

(define REVIEW-PAGE
  (str
    "<!DOCTYPE html>"
    "<html lang=\"ko\">"
    "<head>"
    "<meta charset=\"UTF-8\">"
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">"
    "<title>Phase 0 검수 트리 - BigWash</title>"
    "<style>" REVIEW-STYLES "</style>"
    "</head>"
    "<body>"
    "<header class='header'>"
    "<div class='header-container'>"
    "<div class='logo-section'>"
    "<div class='logo'>"
    "<span class='logo-icon'>⚡</span>"
    "<span class='logo-text'>BigWash</span>"
    "</div>"
    "<span class='logo-subtext'>검수 트리</span>"
    "</div>"
    "<nav class='nav'>"
    "<a href='/review/phase0' class='nav-link'>Phase 0 검수</a>"
    "</nav>"
    "<div class='user-section'>"
    "<div class='user-avatar'>RV</div>"
    "</div>"
    "</div>"
    "</header>"
    "<main class='main-content'>"
    "<div class='review-shell'>"
    (render-phase0-review-hero
      "Phase 0 검수 결과를 단독 AFJ 서버로 띄운 화면"
      (str "03-phase0-validation-runbook.md 검수 결과를 루트 판단과 세 갈래 이슈로 정리했다. "
           "이 페이지는 DB를 읽지 않고, 검수 결과만 로컬 서버에서 직접 렌더한다.")
      "DB 없음")
    (render-phase0-review-grid nil)
    "</div>"
    "</main>"
    "</body>"
    "</html>"))

(defn handle-root [req]
  (server_html REVIEW-PAGE))

(server_get "/" "handle-root")
(server_get "/review/phase0" "handle-root")

(define PORT 41200)
(println (str "🚀 Review Server starting on port " PORT))
(server_start PORT)
