;;; BigWash Care Phase 1 HTTP API

;; 배포 위치(노드)에 따라 절대경로가 달라지므로 PWD 기준으로 계산한다.
(define REPO-ROOT
  (let [override (env-get "BIGWASH_REPO_ROOT")]
    (if (or (nil? override) (str-blank? override)) (env-get "PWD") override)))

(load (str REPO-ROOT "/src/operations.fl"))

(define CARE-PORT
  (let [override (env-get "BIGWASH_CARE_PORT")]
    (if (or (nil? override) (str-blank? override)) 40101 (int override))))

(define ADMIN-HTML (file_read (str REPO-ROOT "/src/washcare-admin.html")))
(define OPERATIONS-HTML (file_read (str REPO-ROOT "/src/operations-admin.html")))

;; ---- 운영 보안 게이트(P0/P1, 2026-07-22) ----
;;
;; 과거(2026-07-19) 결정은 "BIGWASH_INTERNAL_API_KEY 미설정 시 전체 무인증
;; 허용"(fail-open)이었다. 이 결정은 여기서 뒤집는다 — 이제 기본값은
;; **fail-closed**다. BIGWASH_INTERNAL_API_KEY가 비어 있으면 내부 API는
;; 무조건 거부되고, 오직 BIGWASH_ALLOW_INSECURE_DEV=1을 명시적으로 설정한
;; 로컬 개발 모드에서만 과거의 공개 동작(키 없이도 통과)을 허용한다. 공개
;; 조회 엔드포인트(/care/status/:token, /care/site-status/:token)는 원래부터
;; 별도 보안 모델(토큰 해시, rate limit, no-store)로 동작하고 이 게이트와
;; 무관하다 — 이번 변경으로 손대지 않는다.
(defn insecure-dev-mode? []
  (= "1" (str (env-get "BIGWASH_ALLOW_INSECURE_DEV"))))

(if (insecure-dev-mode?)
  (println "⚠️  BIGWASH_ALLOW_INSECURE_DEV=1 — 로컬 개발 전용 무인증 모드입니다. 운영 배포에 이 값을 설정하지 마세요.")
  (if (or (nil? (env-get "BIGWASH_INTERNAL_API_KEY")) (str-blank? (env-get "BIGWASH_INTERNAL_API_KEY")))
    (println "🔒 BIGWASH_INTERNAL_API_KEY 미설정 — 내부 /care API는 기본 정책(fail-closed)에 따라 전부 401을 반환합니다. 로컬 개발 중이라면 BIGWASH_ALLOW_INSECURE_DEV=1을 명시하세요.")))

;; 순수 정책 함수 — env/req I/O 없이 세 값(설정된 키, 요청이 보낸 값, 로컬
;; 개발 모드 여부)만으로 허용 여부를 결정한다. tests/test_security_gate.fl이
;; 서버를 띄우거나 진짜 요청 객체를 만들지 않고도 이 정책을 직접 단정할 수
;; 있도록 internal-authorized?/call-webhook-authorized?에서 분리했다.
(defn auth-policy [expected supplied insecure-dev]
  (if (or (nil? expected) (str-blank? expected))
    ;; 키 미설정: 기본은 거부(fail-closed). 명시적 로컬 개발 모드일 때만 통과.
    insecure-dev
    ;; 단순 문자열 비교 대신 해시 비교 — 원문 길이·바이트 단위 조기 불일치로
    ;; 새는 타이밍 정보를 줄인다.
    (= (sha256 expected) (sha256 (if (nil? supplied) "" supplied)))))

(defn internal-authorized? [req]
  (auth-policy (env-get "BIGWASH_INTERNAL_API_KEY") (server_req_header req "x-api-key") (insecure-dev-mode?)))

(defn unauthorized []
  (server_header
    (server_status 401 {:ok false :error "Unauthorized"})
    "Cache-Control" "no-store"))

;; mobserve 같은 자동화 앱은 커스텀 헤더를 못 보낸다(소스 확인함 —
;; OkHttp로 header 없이 순수 JSON POST만 함) — 그래서 이 엔드포인트만
;; 쿼리파라미터(?key=)로 같은 BIGWASH_INTERNAL_API_KEY를 받는다. 인증 정책은
;; internal-authorized?와 동일하게 fail-closed로 맞춘다.
(defn call-webhook-authorized? [req]
  (auth-policy (env-get "BIGWASH_INTERNAL_API_KEY") (server_req_query req "key") (insecure-dev-mode?)))

;; GET /care/admin 접근 경계 — Admin UI는 그 자체로 고객 이름·연락처·계약
;; 정보를 렌더링하는 HTML이라 데이터 API 키와는 별도로 HTTP Basic 경계를
;; 요구한다. BIGWASH_ADMIN_BASIC_AUTH에는 완전한 Authorization 헤더 값
;; ("Basic base64(user:pass)")을 그대로 넣는다 — 아이디/비밀번호를 서버가
;; 분해·재조합하지 않고 헤더 문자열 단위로 해시 비교만 한다. 미설정 시
;; 무조건 거부(fail-closed)한다. BIGWASH_ALLOW_INSECURE_DEV=1은 데이터 API
;; 개발 편의만 풀며 Admin HTML 경계는 풀지 않는다. admin-auth-policy의 세 번째
;; 인자는 auth-policy와 동일한 테스트 인터페이스를 유지하기 위해 받지만 보안
;; 결정에는 사용하지 않는다.
(defn admin-auth-policy [expected supplied insecure-dev]
  (if (or (nil? expected) (str-blank? expected))
    false
    (= (sha256 expected) (sha256 (if (nil? supplied) "" supplied)))))

(defn admin-authorized? [req]
  (admin-auth-policy (env-get "BIGWASH_ADMIN_BASIC_AUTH") (server_req_header req "Authorization") (insecure-dev-mode?)))

;; 운영 기록실은 Admin Basic을 통과한 브라우저가 같은 출처의 JSON API를
;; 바로 사용할 수 있어야 한다. 자동화·내부 연동의 x-api-key도 계속 허용한다.
(defn wash-ops-authorized? [req]
  (or (internal-authorized? req) (admin-authorized? req)))

(defn admin-unauthorized []
  (server_header
    (server_header
      (server_status 401 {:ok false :error "Unauthorized"})
      "WWW-Authenticate" "Basic realm=\"BigWash Admin\"")
    "Cache-Control" "no-store"))

(defn no-store [response]
  (server_header response "Cache-Control" "no-store"))

;; ---- 캐치된 예외를 안전하게 클라이언트에 노출하는 공통 헬퍼 ----
;;
;; FreeLang의 (str e)는 message·stack("... at line N, col M")·전체 호출스택
;; (__flCallStack, 파일 절대경로 포함)까지 JSON으로 직렬화한다 — 그대로
;; 클라이언트에 내려보내면 내부 구현이 노출된다(과거 docs/04-washcare-api.md
;; "알려진 개선 후보"에 기록된 문제). 전체 예외는 여기서 서버 로그(stdout,
;; pm2 logs로 수집)에만 남기고, 클라이언트에는 e의 :message 필드(실측 결과
;; 도메인 검증 오류·SQLite 제약 위반·타입 오류 전부 경로/줄번호/스택을
;; 포함하지 않음)를 방어적으로 한 번 더 새니타이즈해 돌려준다. 기존
;; "Site not found" 류의 명시적 400/404 도메인 계약 문구는 이 경로로 그대로
;; 보존된다.
(defn log-caught-exception [context e]
  (println (str "[safe-error] " context ": " (str e))))

(defn sanitize-error-text [raw-text]
  (let [as-str (str raw-text)
        no-paths (regex_replace as-str "(/[A-Za-z0-9_.\\-]+){2,}" "[REDACTED]")
        no-loc (regex_replace no-paths "\\(at line [0-9]+, col [0-9]+\\)" "")
        no-brackets (regex_replace no-loc "\\[[a-z][a-z0-9_\\-]*\\]\\s*" "")
        trimmed (str_trim no-brackets)
        capped (if (> (length trimmed) 300) (str (substring trimmed 0 300) "...") trimmed)]
    (if (or (str-blank? capped)
            (= capped "null")
            (= capped "nil")
            (regex_match capped "db_exec")
            (regex_match capped "SQLITE")
            (regex_match capped "constraint failed")
            (regex_match capped "__flCallStack")
            (regex_match capped "SELECT ")
            (regex_match capped "INSERT ")
            (regex_match capped "UPDATE ")
            (regex_match capped "DELETE "))
      "Request failed"
      capped)))

(defn safe-error-response [context e]
  (do
    (log-caught-exception context e)
    (server_status 400 {:ok false :error (sanitize-error-text (get e :message))})))

;; 위와 동일하게 서버 로그는 남기되, 클라이언트에는 항상 고정된 문구만
;; 돌려준다(다단계 오케스트레이션이라 원문 메시지가 불안정하거나, days/
;; warranty_days/as_of처럼 파라미터 파싱 실패가 뻔한 경우 — 기존 계약 그대로).
(defn safe-error-response-fixed [context e fixed-message]
  (do
    (log-caught-exception context e)
    (server_status 400 {:ok false :error fixed-message})))

(defn request-ip [req]
  (let [real-ip (server_req_header req "x-real-ip")]
    (if (or (nil? real-ip) (str-blank? real-ip)) "unknown" real-ip)))

(defn parse-int-param [value field-name]
  (let [raw (str value)]
    (cond
      [(or (nil? value) (str-blank? raw)) nil]
      [(not (regex_match raw "^[0-9]+$"))
       (error (str field-name " must be an integer"))]
      [true
       (let [parsed (int raw)]
         (if (<= parsed 0)
           (error (str field-name " must be greater than 0"))
           parsed))])))

(defn handle-create-customer [req]
  (if (internal-authorized? req)
    (try
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-customer
                              (get body :name)
                              (get body :phone)
                              (get body :email)
                              (get body :memo)
                              (get body :customer_type)
                              (get body :address))}))
      (catch [e]
        (safe-error-response "handle-create-customer" e)))
    (unauthorized)))

