;; BIGWASH_SKIP_SERVER_START=1이면 라우트 등록까지만 하고 실제로 포트를
;; 열지 않는다 — tests/test_security_gate.fl이 이 파일을 load해서 순수
;; 정책 함수(auth-policy/admin-auth-policy/sanitize-error-text 등)를 직접
;; 호출하기 위한 용도만이다. 운영/로컬 정상 기동 시에는 이 값을 설정하지
;; 않으므로 기존 동작(server_start 호출)이 그대로 유지된다.
(if (= "1" (str (env-get "BIGWASH_SKIP_SERVER_START")))
  (println "(BIGWASH_SKIP_SERVER_START=1 — 라우트만 등록하고 server_start는 건너뜀, 테스트 전용)")
  (do
    (println (str "BigWash Care Phase 1 API starting on port " CARE-PORT))
    (server_start CARE-PORT)))
