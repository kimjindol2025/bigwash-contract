(defn handle-update-ticket-status [req]
  (if (internal-authorized? req)
    (try
      (let [ticket-id (parse-int-param (server_req_param req "id") "id")
            body (server_req_json req)]
        (server_json {:ok true
                      :data (update-ticket-status ticket-id (get body :status))}))
      (catch [e]
        (if (= (str (get e :message)) "Service ticket not found")
          (server_status 404 {:ok false :error "Not found"})
          (safe-error-response "handle-update-ticket-status" e))))
    (unauthorized)))

