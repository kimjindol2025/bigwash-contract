;;; BigWash Care Phase 1 HTTP API

(load "/home/kim/kim/bigwash-contract/src/washcare.fl")

(define CARE-PORT
  (let [override (env-get "BIGWASH_CARE_PORT")]
    (if (or (nil? override) (str-blank? override)) 40101 (int override))))

(define ADMIN-HTML (file_read "/home/kim/kim/bigwash-contract/src/washcare-admin.html"))

(defn internal-authorized? [req]
  (let [expected (env-get "BIGWASH_INTERNAL_API_KEY")
        supplied (server_req_header req "x-api-key")]
    (if (or (nil? expected) (str-blank? expected))
      true
      (= expected supplied))))

(defn unauthorized []
  (server_status 401 {:ok false :error "Unauthorized"}))

(defn no-store [response]
  (server_header response "Cache-Control" "no-store"))

(defn request-ip [req]
  (let [real-ip (server_req_header req "x-real-ip")]
    (if (or (nil? real-ip) (str-blank? real-ip)) "unknown" real-ip)))

(defn handle-create-customer [req]
  (if (internal-authorized? req)
    (try
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-customer
                              (get body :name)
                              (get body :phone)
                              (get body :email)
                              (get body :memo)
                              (get body :customer_type)
                              (get body :address))}))
      (catch [e]
        (server_status 400 {:ok false :error (str e)})))
    (unauthorized)))

(defn handle-create-site [req]
  (if (internal-authorized? req)
    (do
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-site
                              (get body :customer_id)
                              (get body :name)
                              (get body :address)
                              (get body :contact_phone))})))
    (unauthorized)))

(defn handle-list-customer-sites [req]
  (if (internal-authorized? req)
    (server_json {:ok true
                  :data (list-customer-sites (server_req_query req "customer_id"))})
    (unauthorized)))

(defn handle-create-equipment [req]
  (if (internal-authorized? req)
    (do
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-equipment
                              (get body :site_id)
                              (get body :contract_id)
                              (get body :category)
                              (get body :model)
                              (get body :serial_number)
                              (get body :installed_at)
                              (get body :warranty_ends_at))})))
    (unauthorized)))

(defn handle-list-customer-equipment [req]
  (if (internal-authorized? req)
    (server_json {:ok true
                  :data (list-customer-equipment (server_req_query req "customer_id"))})
    (unauthorized)))

(defn handle-create-ticket [req]
  (if (internal-authorized? req)
    (do
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-service-ticket
                              (get body :site_id)
                              (get body :equipment_id)
                              (get body :symptom)
                              (get body :priority)
                              (get body :source)
                              (get body :scheduled_at))})))
    (unauthorized)))

(defn handle-update-ticket-status [req]
  (if (internal-authorized? req)
    (do
      (let [ticket-id (server_req_param req "id")
            body (server_req_json req)]
        (server_json {:ok true
                      :data (update-ticket-status ticket-id (get body :status))})))
    (unauthorized)))

(defn handle-add-visit [req]
  (if (internal-authorized? req)
    (do
      (let [ticket-id (server_req_param req "id")
            body (server_req_json req)]
        (server_json {:ok true
                      :data (add-service-visit
                              ticket-id
                              (get body :technician)
                              (get body :visited_at)
                              (get body :diagnosis)
                              (get body :action_taken)
                              (get body :parts_used)
                              (get body :labor_cost)
                              (get body :parts_cost)
                              (get body :next_inspection_at))})))
    (unauthorized)))

(defn handle-revoke-link [req]
  (if (internal-authorized? req)
    (do
      (server_json {:ok (revoke-public-link (server_req_param req "id"))}))
    (unauthorized)))

(defn handle-reissue-link [req]
  (if (internal-authorized? req)
    (do
      (server_json {:ok true
                    :data (reissue-public-link (server_req_param req "id"))}))
    (unauthorized)))

(defn handle-public-ticket [req]
  (let [token (server_req_param req "token")
        result (get-public-ticket token (request-ip req))]
    (cond
      [(nil? result)
       (no-store (server_status 404 {:ok false :error "Not found"}))]
      [(= (get result :result) "RATE_LIMITED")
       (no-store (server_status 429 {:ok false :error "Too many requests"}))]
      [true
       (no-store (server_json {:ok true :data result}))])))

;; Admin UI 목록/검색/상세 — 전부 내부 인증 필요.
(defn handle-list-tickets [req]
  (if (internal-authorized? req)
    (let [customer-id (server_req_query req "customer_id")
          status (server_req_query req "status")
          today (server_req_query req "today")]
      (if (or (nil? customer-id) (str-blank? customer-id))
        (server_json {:ok true
                      :data (list-tickets-by-status status (= today "1"))})
        (server_json {:ok true
                      :data (list-customer-tickets customer-id)})))
    (unauthorized)))

(defn handle-ticket-detail [req]
  (if (internal-authorized? req)
    (let [detail (get-ticket-detail (server_req_param req "id"))]
      (if (nil? detail)
        (server_status 404 {:ok false :error "Not found"})
        (server_json {:ok true :data detail})))
    (unauthorized)))

(defn handle-search-customers [req]
  (if (internal-authorized? req)
    (server_json {:ok true
                  :data (search-customers
                          (or (server_req_query req "q") "")
                          (or (server_req_query req "filter") "ALL"))})
    (unauthorized)))

