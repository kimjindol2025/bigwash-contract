(defn handle-register-sale [req]
  (if (internal-authorized? req)
    (try
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (register-sale
                              (get body :customer_id)
                              (get body :customer_name)
                              (get body :customer_phone)
                              (get body :customer_email)
                              (get body :site_name)
                              (get body :site_address)
                              (get body :site_contact_phone)
                              (get body :contract_id)
                              (or (get body :equipment) [])
                              (or (get body :first_outreach_days) 90))}))
      (catch [e]
        (safe-error-response-fixed "handle-register-sale" e "Invalid sale request")))
    (unauthorized)))

(defn handle-site-public-status [req]
  (let [token (server_req_param req "token")
        result (get-site-public-view token (request-ip req))]
    (cond
      [(nil? result)
       (no-store (server_status 404 {:ok false :error "Not found"}))]
      [(= (get result :result) "RATE_LIMITED")
       (no-store (server_status 429 {:ok false :error "Too many requests"}))]
      [true
       (no-store (server_json {:ok true :data result}))])))

(defn handle-revoke-site-link [req]
  (if (internal-authorized? req)
    (if (revoke-site-link (server_req_param req "id"))
      (server_json {:ok true})
      (server_status 404 {:ok false :error "Not found"}))
    (unauthorized)))

(defn handle-reissue-site-link [req]
  (if (internal-authorized? req)
    (let [result (reissue-site-link (server_req_param req "id"))]
      (if (nil? result)
        (server_status 404 {:ok false :error "Not found"})
        (server_json {:ok true :data result})))
    (unauthorized)))

(defn handle-warranty-expiring [req]
  (if (internal-authorized? req)
    (try
      (server_json {:ok true
                    :data (list-warranty-expiring (or (server_req_query req "days") "30"))})
      (catch [e]
        (safe-error-response-fixed "handle-warranty-expiring" e "days must be an integer between 0 and 3650")))
    (unauthorized)))

;; 2026-07-21 추가: 운영 대시보드 집계(2주차, docs/09 §3) — 지연·일정미정·오늘방문·
;; 보증임박 4개 섹션. 미수금은 PaymentOrder 정의 전이라 포함하지 않는다(docs/09 0장).
(defn handle-ops-summary [req]
  (if (internal-authorized? req)
    (try
      (server_json {:ok true
                    :data (get-ops-summary (server_req_query req "warranty_days"))})
      (catch [e]
        (safe-error-response-fixed "handle-ops-summary" e "warranty_days must be an integer between 0 and 3650")))
    (unauthorized)))

;; 2026-07-21 추가: 주간 운영보고(3주차, docs/09 §4) — 미처리 A/S·다음 주 방문·
;; 점검 대상 3개 섹션. 미수금은 이번 로드맵 원칙상 응답에 넣지 않는다.
(defn handle-ops-weekly [req]
  (if (internal-authorized? req)
    (try
      (server_json {:ok true
                    :data (get-ops-weekly (server_req_query req "as_of"))})
      (catch [e]
        (safe-error-response-fixed "handle-ops-weekly" e "as_of must be a valid YYYY-MM-DD date")))
    (unauthorized)))

;; 2026-07-21 추가 (4주차): 연간관리 CarePlan CRUD + 취소/갱신.
(defn handle-create-careplan [req]
  (if (internal-authorized? req)
    (try
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-care-plan
                              (parse-int-param (get body :site_id) "site_id")
                              (get body :plan_code)
                              (get body :starts_at)
                              (get body :price_snapshot)
                              (get body :included_visits)
                              (get body :next_inspection_at)
                              (get body :memo))}))
      (catch [e]
        (safe-error-response "handle-create-careplan" e)))
    (unauthorized)))

;; 5주차 선행: site_id/customer_id 둘 다 없으면 더 이상 400이 아니라 전체
;; 목록(최신순 최대 50건)을 반환한다 — Admin CarePlan 모듈의 "전체 가입 현황"용.
(defn handle-list-careplans [req]
  (if (internal-authorized? req)
    (try
      (let [site-id (parse-int-param (server_req_query req "site_id") "site_id")
            customer-id (parse-int-param (server_req_query req "customer_id") "customer_id")]
        (cond
          [(not (nil? site-id)) (server_json {:ok true :data (list-site-careplans site-id)})]
          [(not (nil? customer-id)) (server_json {:ok true :data (list-customer-careplans customer-id)})]
          [true (server_json {:ok true :data (list-all-careplans)})]))
      (catch [e]
        (safe-error-response "handle-list-careplans" e)))
    (unauthorized)))

(defn handle-careplan-detail [req]
  (if (internal-authorized? req)
    (let [plan (get-careplan (parse-int-param (server_req_param req "id") "id"))]
      (if (nil? plan)
        (server_status 404 {:ok false :error "Care plan not found"})
        (server_json {:ok true :data plan})))
    (unauthorized)))

(defn handle-update-careplan [req]
  (if (internal-authorized? req)
    (let [id (parse-int-param (server_req_param req "id") "id")]
      (if (nil? (get-careplan id))
        (server_status 404 {:ok false :error "Care plan not found"})
        (try
          (let [body (server_req_json req)]
            (server_json {:ok true
                          :data (update-care-plan
                                  id
                                  (get body :used_visits)
                                  (get body :next_inspection_at)
                                  (get body :memo))}))
          (catch [e]
            (safe-error-response "handle-update-careplan" e)))))
    (unauthorized)))

(defn handle-cancel-careplan [req]
  (if (internal-authorized? req)
    (let [id (parse-int-param (server_req_param req "id") "id")]
      (if (nil? (get-careplan id))
        (server_status 404 {:ok false :error "Care plan not found"})
        (try
          (let [body (server_req_json req)]
            (server_json {:ok true :data (cancel-care-plan id (get body :memo))}))
          (catch [e]
            (safe-error-response "handle-cancel-careplan" e)))))
    (unauthorized)))

(defn handle-renew-careplan [req]
  (if (internal-authorized? req)
    (let [id (parse-int-param (server_req_param req "id") "id")]
      (if (nil? (get-careplan id))
        (server_status 404 {:ok false :error "Care plan not found"})
        (try
          (let [body (server_req_json req)]
            (server_json {:ok true
                          :data (renew-care-plan
                                  id
                                  (get body :plan_code)
                                  (get body :starts_at)
                                  (get body :price_snapshot)
                                  (get body :included_visits))}))
          (catch [e]
            (safe-error-response "handle-renew-careplan" e)))))
    (unauthorized)))

(server_post "/care/customers" "handle-create-customer")
(server_get  "/care/customers" "handle-search-customers")
(server_get  "/care/customers/:id" "handle-customer-detail")
(server_get  "/care/incoming-call" "handle-incoming-call")
(server_post "/care/call-events" "handle-call-event-webhook")
(server_post "/care/consultations" "handle-create-consultation")
(server_get  "/care/consultations" "handle-list-consultations")
(server_put  "/care/consultations/:id/complete" "handle-complete-consultation")
(server_get  "/care/consultations/due-today" "handle-followups-today")
