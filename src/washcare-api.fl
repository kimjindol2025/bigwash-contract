;;; BigWash Care Phase 1 HTTP API

(load "/root/apps/bigwash-contract/src/washcare.fl")

(define CARE-PORT
  (let [override (env-get "BIGWASH_CARE_PORT")]
    (if (or (nil? override) (str-blank? override)) 40101 (int override))))

(define ADMIN-HTML (file_read "/root/apps/bigwash-contract/src/washcare-admin.html"))

(defn internal-authorized? [req]
  (let [expected (env-get "BIGWASH_INTERNAL_API_KEY")
        supplied (server_req_header req "x-api-key")]
    (and (not (nil? expected))
         (not (str-blank? expected))
         (= expected supplied))))

(defn unauthorized []
  (server_status 401 {:ok false :error "Unauthorized"}))

(defn no-store [response]
  (server_header response "Cache-Control" "no-store"))

(defn request-ip [req]
  (let [real-ip (server_req_header req "x-real-ip")]
    (if (or (nil? real-ip) (str-blank? real-ip)) "unknown" real-ip)))

(defn handle-create-customer [req]
  (if (internal-authorized? req)
    (do
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-customer
                              (get body :name)
                              (get body :phone)
                              (get body :email)
                              (get body :memo))})))
    (unauthorized)))

(defn handle-create-site [req]
  (if (internal-authorized? req)
    (do
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-site
                              (get body :customer_id)
                              (get body :name)
                              (get body :address)
                              (get body :contact_phone))})))
    (unauthorized)))

(defn handle-create-equipment [req]
  (if (internal-authorized? req)
    (do
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-equipment
                              (get body :site_id)
                              (get body :contract_id)
                              (get body :category)
                              (get body :model)
                              (get body :serial_number)
                              (get body :installed_at)
                              (get body :warranty_ends_at))})))
    (unauthorized)))

(defn handle-create-ticket [req]
  (if (internal-authorized? req)
    (do
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (create-service-ticket
                              (get body :site_id)
                              (get body :equipment_id)
                              (get body :symptom)
                              (get body :priority)
                              (get body :source)
                              (get body :scheduled_at))})))
    (unauthorized)))

(defn handle-update-ticket-status [req]
  (if (internal-authorized? req)
    (do
      (let [ticket-id (server_req_param req "id")
            body (server_req_json req)]
        (server_json {:ok true
                      :data (update-ticket-status ticket-id (get body :status))})))
    (unauthorized)))

(defn handle-add-visit [req]
  (if (internal-authorized? req)
    (do
      (let [ticket-id (server_req_param req "id")
            body (server_req_json req)]
        (server_json {:ok true
                      :data (add-service-visit
                              ticket-id
                              (get body :technician)
                              (get body :visited_at)
                              (get body :diagnosis)
                              (get body :action_taken)
                              (get body :parts_used)
                              (get body :labor_cost)
                              (get body :parts_cost)
                              (get body :next_inspection_at))})))
    (unauthorized)))

(defn handle-revoke-link [req]
  (if (internal-authorized? req)
    (do
      (server_json {:ok (revoke-public-link (server_req_param req "id"))}))
    (unauthorized)))

(defn handle-reissue-link [req]
  (if (internal-authorized? req)
    (do
      (server_json {:ok true
                    :data (reissue-public-link (server_req_param req "id"))}))
    (unauthorized)))

(defn handle-public-ticket [req]
  (let [token (server_req_param req "token")
        result (get-public-ticket token (request-ip req))]
    (cond
      [(nil? result)
       (no-store (server_status 404 {:ok false :error "Not found"}))]
      [(= (get result :result) "RATE_LIMITED")
       (no-store (server_status 429 {:ok false :error "Too many requests"}))]
      [true
       (no-store (server_json {:ok true :data result}))])))

;; Admin UI 목록/검색/상세 — 전부 내부 인증 필요.
(defn handle-list-tickets [req]
  (if (internal-authorized? req)
    (let [status (server_req_query req "status")
          today (server_req_query req "today")]
      (server_json {:ok true
                    :data (list-tickets-by-status status (= today "1"))}))
    (unauthorized)))

(defn handle-ticket-detail [req]
  (if (internal-authorized? req)
    (let [detail (get-ticket-detail (server_req_param req "id"))]
      (if (nil? detail)
        (server_status 404 {:ok false :error "Not found"})
        (server_json {:ok true :data detail})))
    (unauthorized)))

(defn handle-search-customers [req]
  (if (internal-authorized? req)
    (server_json {:ok true :data (search-customers (or (server_req_query req "q") ""))})
    (unauthorized)))

(defn handle-admin-page [req]
  (server_html ADMIN-HTML))

;; ---- 부품판매 ----
(defn handle-create-part-sale [req]
  (if (internal-authorized? req)
    (let [body (server_req_json req)]
      (server_json {:ok true
                    :data (create-part-sale
                            (get body :site_id)
                            (get body :equipment_id)
                            (get body :ticket_id)
                            (get body :part_name)
                            (or (get body :quantity) 1)
                            (get body :unit_price)
                            (or (get body :channel) "STORE"))}))
    (unauthorized)))

(defn handle-list-part-sales [req]
  (if (internal-authorized? req)
    (server_json {:ok true :data (list-site-part-sales (server_req_query req "site_id"))})
    (unauthorized)))

;; ---- 휴면기 관리·홍보 ----
(defn handle-create-outreach [req]
  (if (internal-authorized? req)
    (let [body (server_req_json req)]
      (server_json {:ok true
                    :data (create-outreach-touch
                            (get body :site_id)
                            (get body :equipment_id)
                            (or (get body :touch_type) "CHECKIN")
                            (or (get body :channel) "PHONE")
                            (get body :next_touch_at))}))
    (unauthorized)))

(defn handle-outreach-response [req]
  (if (internal-authorized? req)
    (let [touch-id (server_req_param req "id")
          body (server_req_json req)]
      (server_json {:ok true
                    :data (record-outreach-response
                            touch-id
                            (get body :response)
                            (get body :converted_to)
                            (get body :converted_ref_id)
                            (get body :next_touch_at))}))
    (unauthorized)))

(defn handle-outreach-due [req]
  (if (internal-authorized? req)
    (server_json {:ok true :data (list-due-outreach)})
    (unauthorized)))

;; ---- 판매 관리 ----
(defn handle-register-sale [req]
  (if (internal-authorized? req)
    (let [body (server_req_json req)]
      (server_json {:ok true
                    :data (register-sale
                            (get body :customer_id)
                            (get body :customer_name)
                            (get body :customer_phone)
                            (get body :customer_email)
                            (get body :site_name)
                            (get body :site_address)
                            (get body :site_contact_phone)
                            (get body :contract_id)
                            (or (get body :equipment) [])
                            (or (get body :first_outreach_days) 90))}))
    (unauthorized)))

(defn handle-site-public-status [req]
  (let [token (server_req_param req "token")
        result (get-site-public-view token (request-ip req))]
    (cond
      [(nil? result)
       (no-store (server_status 404 {:ok false :error "Not found"}))]
      [(= (get result :result) "RATE_LIMITED")
       (no-store (server_status 429 {:ok false :error "Too many requests"}))]
      [true
       (no-store (server_json {:ok true :data result}))])))

(defn handle-revoke-site-link [req]
  (if (internal-authorized? req)
    (server_json {:ok (revoke-site-link (server_req_param req "id"))})
    (unauthorized)))

(defn handle-reissue-site-link [req]
  (if (internal-authorized? req)
    (server_json {:ok true :data (reissue-site-link (server_req_param req "id"))})
    (unauthorized)))

(defn handle-warranty-expiring [req]
  (if (internal-authorized? req)
    (server_json {:ok true
                  :data (list-warranty-expiring (or (server_req_query req "days") "30"))})
    (unauthorized)))

(server_post "/care/customers" "handle-create-customer")
(server_get  "/care/customers" "handle-search-customers")
(server_post "/care/sites" "handle-create-site")
(server_post "/care/equipment" "handle-create-equipment")
(server_post "/care/tickets" "handle-create-ticket")
(server_get  "/care/tickets" "handle-list-tickets")
(server_get  "/care/tickets/:id" "handle-ticket-detail")
(server_put  "/care/tickets/:id/status" "handle-update-ticket-status")
(server_post "/care/tickets/:id/visits" "handle-add-visit")
(server_post "/care/tickets/:id/link/revoke" "handle-revoke-link")
(server_post "/care/tickets/:id/link/reissue" "handle-reissue-link")
(server_get  "/care/status/:token" "handle-public-ticket")
(server_post "/care/part-sales" "handle-create-part-sale")
(server_get  "/care/part-sales" "handle-list-part-sales")
(server_post "/care/outreach" "handle-create-outreach")
(server_post "/care/outreach/:id/response" "handle-outreach-response")
(server_get  "/care/outreach/due" "handle-outreach-due")
(server_post "/care/sales" "handle-register-sale")
(server_get  "/care/site-status/:token" "handle-site-public-status")
(server_post "/care/sites/:id/link/revoke" "handle-revoke-site-link")
(server_post "/care/sites/:id/link/reissue" "handle-reissue-site-link")
(server_get  "/care/warranty-expiring" "handle-warranty-expiring")
(server_get  "/care/admin" "handle-admin-page")

(println (str "BigWash Care Phase 1 API starting on port " CARE-PORT))
(server_start CARE-PORT)
