(defn handle-public-ticket [req]
  (let [token (server_req_param req "token")
        result (get-public-ticket token (request-ip req))]
    (cond
      [(nil? result)
       (no-store (server_status 404 {:ok false :error "Not found"}))]
      [(= (get result :result) "RATE_LIMITED")
       (no-store (server_status 429 {:ok false :error "Too many requests"}))]
      [true
       (no-store (server_json {:ok true :data result}))])))

