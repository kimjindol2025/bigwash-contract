;; ---- 휴면기 관리·홍보 ----
(defn handle-create-outreach [req]
  (if (internal-authorized? req)
    (let [body (server_req_json req)]
      (server_json {:ok true
                    :data (create-outreach-touch
                            (get body :site_id)
                            (get body :equipment_id)
                            (or (get body :touch_type) "CHECKIN")
                            (or (get body :channel) "PHONE")
                            (get body :next_touch_at))}))
    (unauthorized)))

(defn handle-outreach-response [req]
  (if (internal-authorized? req)
    (let [touch-id (server_req_param req "id")
          body (server_req_json req)]
      (server_json {:ok true
                    :data (record-outreach-response
                            touch-id
                            (get body :response)
                            (get body :converted_to)
                            (get body :converted_ref_id)
                            (get body :next_touch_at))}))
    (unauthorized)))

(defn handle-outreach-due [req]
  (if (internal-authorized? req)
    (server_json {:ok true :data (list-due-outreach)})
    (unauthorized)))

;; ---- 판매 관리 ----
(defn handle-register-sale [req]
  (if (internal-authorized? req)
    (try
      (let [body (server_req_json req)]
        (server_json {:ok true
                      :data (register-sale
                              (get body :customer_id)
                              (get body :customer_name)
                              (get body :customer_phone)
                              (get body :customer_email)
                              (get body :site_name)
                              (get body :site_address)
                              (get body :site_contact_phone)
                              (get body :contract_id)
                              (or (get body :equipment) [])
                              (or (get body :first_outreach_days) 90))}))
      (catch [e]
        (server_status 400 {:ok false :error "Invalid sale request"})))
    (unauthorized)))

(defn handle-site-public-status [req]
  (let [token (server_req_param req "token")
        result (get-site-public-view token (request-ip req))]
    (cond
      [(nil? result)
       (no-store (server_status 404 {:ok false :error "Not found"}))]
      [(= (get result :result) "RATE_LIMITED")
       (no-store (server_status 429 {:ok false :error "Too many requests"}))]
      [true
       (no-store (server_json {:ok true :data result}))])))

(defn handle-revoke-site-link [req]
  (if (internal-authorized? req)
    (if (revoke-site-link (server_req_param req "id"))
      (server_json {:ok true})
      (server_status 404 {:ok false :error "Not found"}))
    (unauthorized)))

(defn handle-reissue-site-link [req]
  (if (internal-authorized? req)
    (let [result (reissue-site-link (server_req_param req "id"))]
      (if (nil? result)
        (server_status 404 {:ok false :error "Not found"})
        (server_json {:ok true :data result})))
    (unauthorized)))

(defn handle-warranty-expiring [req]
  (if (internal-authorized? req)
    (try
      (server_json {:ok true
                    :data (list-warranty-expiring (or (server_req_query req "days") "30"))})
      (catch [e]
        (server_status 400 {:ok false :error "days must be an integer between 0 and 3650"})))
    (unauthorized)))

(server_post "/care/customers" "handle-create-customer")
(server_get  "/care/customers" "handle-search-customers")
(server_get  "/care/customers/:id" "handle-customer-detail")
(server_post "/care/consultations" "handle-create-consultation")
(server_get  "/care/consultations" "handle-list-consultations")
(server_put  "/care/consultations/:id/complete" "handle-complete-consultation")
(server_get  "/care/consultations/due-today" "handle-followups-today")
(server_get  "/care/consultations/recent" "handle-recent-consultations")
(server_get  "/care/consultations/pending" "handle-pending-actions")
(server_post "/care/sites" "handle-create-site")
(server_get  "/care/sites" "handle-list-customer-sites")
(server_post "/care/equipment" "handle-create-equipment")
(server_get  "/care/equipment" "handle-list-customer-equipment")
(server_post "/care/customer-contacts" "handle-create-contact")
(server_get  "/care/customer-contacts" "handle-list-contacts")
(server_post "/care/customer-tasks" "handle-create-task")
(server_get  "/care/customer-tasks" "handle-list-tasks")
(server_put  "/care/customer-tasks/:id/complete" "handle-complete-task")
(server_post "/care/customer-followups" "handle-create-followup")
(server_get  "/care/customer-followups" "handle-list-followups")
(server_put  "/care/customer-followups/:id/complete" "handle-complete-followup")
(server_post "/care/quotes" "handle-create-quote")
(server_get  "/care/quotes" "handle-list-customer-quotes")
(server_put  "/care/quotes/:id/status" "handle-update-quote-status")
(server_post "/care/quotes/:id/convert" "handle-convert-quote")
(server_get  "/care/contracts" "handle-list-customer-contracts")
(server_post "/care/tickets" "handle-create-ticket")
(server_get  "/care/tickets" "handle-list-tickets")
(server_get  "/care/tickets/:id" "handle-ticket-detail")
(server_put  "/care/tickets/:id/status" "handle-update-ticket-status")
(server_post "/care/tickets/:id/visits" "handle-add-visit")
(server_post "/care/tickets/:id/link/revoke" "handle-revoke-link")
(server_post "/care/tickets/:id/link/reissue" "handle-reissue-link")
(server_get  "/care/status/:token" "handle-public-ticket")
(server_post "/care/part-sales" "handle-create-part-sale")
(server_get  "/care/part-sales" "handle-list-part-sales")
(server_post "/care/outreach" "handle-create-outreach")
(server_post "/care/outreach/:id/response" "handle-outreach-response")
(server_get  "/care/outreach/due" "handle-outreach-due")
(server_post "/care/sales" "handle-register-sale")
(server_get  "/care/site-status/:token" "handle-site-public-status")
(server_post "/care/sites/:id/link/revoke" "handle-revoke-site-link")
(server_post "/care/sites/:id/link/reissue" "handle-reissue-site-link")
(server_get  "/care/warranty-expiring" "handle-warranty-expiring")
(server_get  "/care/admin" "handle-admin-page")
(server_get  "/" "handle-root")

(println (str "BigWash Care Phase 1 API starting on port " CARE-PORT))
(server_start CARE-PORT)
