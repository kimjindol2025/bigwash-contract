;; 전화 수신 자동조회 — 안드로이드 Tasker/MacroDroid가 발신번호를 여기로
;; 넘기면 팝업에 띄울 최소 정보(이름·최근상담·다음조치)를 돌려준다.
;; GET인 이유: 조회 전용이라 Tasker의 기본 HTTP Request 액션으로 바로 되고,
;; 쿼리파라미터 하나(phone)만 있으면 되니 body를 만들 필요가 없다.
(defn handle-incoming-call [req]
  (if (internal-authorized? req)
    (try
      (let [phone (server_req_query req "phone")]
        (if (or (nil? phone) (str-blank? phone))
          (server_status 400 {:ok false :error "phone query param required"})
          (let [customer (lookup-customer-by-phone phone)]
            (server_json {:ok true :found (not (nil? customer)) :data customer}))))
      (catch [e]
        (safe-error-response "handle-incoming-call" e)))
    (unauthorized)))

;; 자동 통화·문자 로거(안드로이드 mobserve 등) webhook 수신.
;; mobserve의 실제 페이로드(소스 확인, 2026-07-21):
;;   {"event":"call","direction":"incoming","participant":"+8210...",
;;    "duration":143,"date":1609459200000}
;;   {"event":"sms","direction":"incoming","participant":"+8210...",
;;    "content":"...","date":...}
(defn handle-call-event-webhook [req]
  (if (call-webhook-authorized? req)
    (try
      (let [body (server_req_json req)
            mobserve-event (get body :event)
            event-type (if (= mobserve-event "sms") "SMS" "CALL")
            direction (get body :direction)
            participant (get body :participant)
            content (get body :content)
            duration (get body :duration)
            occurred-at-ms (get body :date)]
        (if (or (nil? participant) (nil? direction))
          (server_status 400 {:ok false :error "participant, direction required"})
          (let [result (record-call-event participant event-type direction content duration occurred-at-ms)]
            (server_json {:ok true :data result}))))
      (catch [e]
        (safe-error-response "handle-call-event-webhook" e)))
    (unauthorized)))

