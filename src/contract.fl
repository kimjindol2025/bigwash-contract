;;; Contract Management Logic

(load "db.fl")

;;; Status constants
(define STATUS-DRAFT "DRAFT")
(define STATUS-PENDING "PENDING")
(define STATUS-APPROVED "APPROVED")
(define STATUS-COMPLETED "COMPLETED")
(define STATUS-CANCELLED "CANCELLED")

;;; Create new contract
(define (create-contract client-id amount items)
  (let ((conn (get-conn))
        (contract-num (generate-contract-number)))
    (try
      (do
        ;; Insert contract
        (sqlite-exec conn
          (format "INSERT INTO contracts (number, status, client_id, amount) 
                   VALUES (?, ?, ?, ?)"
                  contract-num STATUS-DRAFT client-id amount))
        
        ;; Get contract ID
        (let ((contract-id 
               (car (sqlite-query conn 
                 "SELECT id FROM contracts WHERE number = ?" contract-num))))
          
          ;; Insert items
          (for-each 
            (lambda (item)
              (sqlite-exec conn
                (format "INSERT INTO contract_items 
                        (contract_id, description, quantity, unit_price, subtotal)
                        VALUES (?, ?, ?, ?, ?)"
                        contract-id
                        (get item "description")
                        (get item "quantity")
                        (get item "unit_price")
                        (* (get item "quantity") (get item "unit_price")))))
            items)
          
          (sqlite-close conn)
          (dict "id" contract-id "number" contract-num "status" STATUS-DRAFT)))
      
      (catch (e)
        (sqlite-close conn)
        (throw (dict "error" (to-string e)))))))

;;; Update contract status
(define (update-status contract-id new-status)
  (let ((conn (get-conn)))
    (try
      (do
        ;; Get current status
        (let ((current-status 
               (car (sqlite-query conn 
                 "SELECT status FROM contracts WHERE id = ?" contract-id))))
          
          ;; Validate status transition
          (if (not (valid-transition? current-status new-status))
            (throw "Invalid status transition"))
          
          ;; Update status
          (sqlite-exec conn
            (format "UPDATE contracts SET status = ?, updated_at = CURRENT_TIMESTAMP 
                     WHERE id = ?" new-status contract-id))
          
          ;; Log history
          (sqlite-exec conn
            (format "INSERT INTO contract_history 
                    (contract_id, old_status, new_status)
                    VALUES (?, ?, ?)"
                    contract-id current-status new-status))
          
          (sqlite-close conn)
          (dict "success" true "old_status" current-status "new_status" new-status)))
      
      (catch (e)
        (sqlite-close conn)
        (throw (dict "error" (to-string e)))))))

;;; Validate status transition
(define (valid-transition? from to)
  (cond
    ((= from STATUS-DRAFT)
     (or (= to STATUS-PENDING) (= to STATUS-CANCELLED)))
    ((= from STATUS-PENDING)
     (or (= to STATUS-APPROVED) (= to STATUS-CANCELLED)))
    ((= from STATUS-APPROVED)
     (or (= to STATUS-COMPLETED) (= to STATUS-CANCELLED)))
    (else false)))

;;; Get contract by ID
(define (get-contract contract-id)
  (let ((conn (get-conn)))
    (try
      (let ((contract 
             (car (sqlite-query conn
               "SELECT * FROM contracts WHERE id = ?" contract-id)))
            (items 
             (sqlite-query conn
               "SELECT * FROM contract_items WHERE contract_id = ?" contract-id)))
        (sqlite-close conn)
        (dict "contract" contract "items" items))
      
      (catch (e)
        (sqlite-close conn)
        (throw (dict "error" (to-string e)))))))

;;; Generate contract number
(define (generate-contract-number)
  (let ((timestamp (to-string (current-time))))
    (format "CTR-%s-%d" 
            (substring timestamp 0 8)
            (random 10000 99999))))

;;; List contracts by status
(define (list-contracts status)
  (let ((conn (get-conn)))
    (try
      (let ((contracts 
             (sqlite-query conn
               "SELECT * FROM contracts WHERE status = ? ORDER BY created_at DESC" 
               status)))
        (sqlite-close conn)
        contracts)
      
      (catch (e)
        (sqlite-close conn)
        (throw (dict "error" (to-string e)))))))
