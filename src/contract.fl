;;; Contract Management Logic

(load "/root/kim/bigwash-contract/src/phase1-db.fl")

;;; Status constants
(define STATUS-DRAFT "DRAFT")
(define STATUS-PENDING "PENDING")
(define STATUS-APPROVED "APPROVED")
(define STATUS-COMPLETED "COMPLETED")
(define STATUS-CANCELLED "CANCELLED")

;;; Validate status transition
(defn valid-transition? [from to]
  (cond
    [(= from STATUS-DRAFT)
     (or (= to STATUS-PENDING) (= to STATUS-CANCELLED))]
    [(= from STATUS-PENDING)
     (or (= to STATUS-APPROVED) (= to STATUS-CANCELLED))]
    [(= from STATUS-APPROVED)
     (or (= to STATUS-COMPLETED) (= to STATUS-CANCELLED))]
    [true false]))

;;; Helper: Insert contract items recursively
(defn insert-items-rec [db-conn contract-id items idx]
  (if (>= idx (length items))
    true
    (let [[item (get items idx)]]
      (db_exec db-conn
        "INSERT INTO contract_items (contract_id, description, quantity, unit_price, subtotal) VALUES (?, ?, ?, ?, ?)"
        [contract-id
         (get item :description)
         (get item :quantity)
         (get item :unit_price)
         (* (get item :quantity) (get item :unit_price))])
      (insert-items-rec db-conn contract-id items (+ idx 1)))))

;;; Create new contract (no try-catch inside, let caller handle errors)
(defn create-contract-impl [customer-id amount items]
  (let [[db-conn (get-db)]
        [contract-num (generate-doc-number "CTR")]
        [shadow-client-id (resolve-shadow-client-id customer-id)]]
    (db_exec db-conn "BEGIN TRANSACTION" [])
    ;; Insert contract
    (db_exec db-conn
      "INSERT INTO contracts (number, status, client_id, customer_id, amount) VALUES (?, ?, ?, ?, ?)"
      [contract-num STATUS-DRAFT shadow-client-id customer-id amount])

    ;; Get contract ID
    (let [[rows (db_query db-conn "SELECT id FROM contracts WHERE number = ?" [contract-num])]]
      (if (= (length rows) 0) (error "Failed to retrieve contract ID"))
      (let [[contract-id (get (first rows) :id)]]
        ;; Insert items
        (insert-items-rec db-conn contract-id items 0)
        ;; Return result
        (db_exec db-conn "COMMIT" [])
        {:id contract-id :number contract-num :status STATUS-DRAFT}))))

;;; Best-effort rollback that preserves the original domain error.
(defn rollback-if-active [db-conn]
  (try
    (do (db_exec db-conn "ROLLBACK" []) true)
    (catch [rollback-error] false)))

;;; Create new contract (with try-catch wrapper)
(defn create-contract [customer-id amount items]
  (try
    (create-contract-impl customer-id amount items)
    (catch [e]
      (let [[db-conn (get-db)]]
        (rollback-if-active db-conn)
        (error (str "Contract creation failed: " e))))))

;;; Update contract status
(defn update-status [contract-id new-status]
  (let [[db-conn (get-db)]]
    (try
      (do
        (db_exec db-conn "BEGIN TRANSACTION" [])
        ;; Get current status
        (let [[rows (db_query db-conn "SELECT status FROM contracts WHERE id = ?" [contract-id])]]
          (if (= (length rows) 0) (error "Contract not found"))
          (let [[current-status (get (first rows) :status)]]

            ;; Validate status transition
            (if (not (valid-transition? current-status new-status))
              (error (str "Invalid status transition")))

            ;; Update status
            (db_exec db-conn
              "UPDATE contracts SET status = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?"
              [new-status contract-id])

            ;; Log history
            (db_exec db-conn
              "INSERT INTO contract_history (contract_id, old_status, new_status) VALUES (?, ?, ?)"
              [contract-id current-status new-status])

            (db_exec db-conn "COMMIT" [])
            {:success true :old_status current-status :new_status new-status})))

      (catch [e]
        (db_exec db-conn "ROLLBACK" [])
        (error (str "Update status failed: " e))))))

;;; Get contract by ID
(defn get-contract [contract-id]
  (let [[db-conn (get-db)]]
    (try
      (let [[contract-rows (db_query db-conn "SELECT * FROM contracts WHERE id = ?" [contract-id])]
            [item-rows (db_query db-conn "SELECT * FROM contract_items WHERE contract_id = ?" [contract-id])]]
        (if (= (length contract-rows) 0) (error "Contract not found"))
        {:contract (first contract-rows) :items item-rows})
      (catch [e]
        (error (str "Get contract failed"))))))

;;; List contracts by status
(defn list-contracts [status]
  (let [[db-conn (get-db)]]
    (try
      (db_query db-conn "SELECT * FROM contracts WHERE status = ? ORDER BY created_at DESC" [status])
      (catch [e]
        (error (str "List contracts failed"))))))
