;;; BigWash Care Phase 1 domain operations

;; 배포 위치(노드)에 따라 절대경로가 달라지므로 PWD 기준으로 계산한다.
(define REPO-ROOT
  (let [override (env-get "BIGWASH_REPO_ROOT")]
    (if (or (nil? override) (str-blank? override)) (env-get "PWD") override)))

(load (str REPO-ROOT "/src/phase1-db.fl"))

(define TICKET-RECEIVED "RECEIVED")
(define TICKET-SCHEDULED "SCHEDULED")
(define TICKET-IN-PROGRESS "IN_PROGRESS")
(define TICKET-COMPLETED "COMPLETED")
(define TICKET-CANCELLED "CANCELLED")

(defn inserted-id [table-name]
  (let [rows (db_query DB (str "SELECT id FROM " table-name " ORDER BY id DESC LIMIT 1") [])]
    (get (first rows) :id)))

(defn valid-customer-type? [customer-type]
  (or (= customer-type "LEAD")
      (= customer-type "CUSTOMER")
      (= customer-type "SERVICE")
      (= customer-type "VENDOR")))

(defn valid-customer-filter? [customer-filter]
  (or (= customer-filter "ALL")
      (valid-customer-type? customer-filter)))

(defn create-customer [name phone email memo customer-type address]
  (let [resolved-type (if (nil? customer-type) "LEAD" customer-type)]
    (if (not (valid-customer-type? resolved-type))
      (error "customer_type must be one of LEAD, CUSTOMER, SERVICE, VENDOR"))
    (do
      (db_exec DB
        "INSERT INTO customers
         (name, phone, email, memo, customer_type, address, migration_status)
         VALUES (?, ?, ?, ?, ?, ?, 'VERIFIED')"
        [name phone email memo resolved-type address])
      (let [id (inserted-id "customers")]
        (first (db_query DB "SELECT * FROM customers WHERE id = ?" [id]))))))

(defn get-customer [customer-id]
  (first (db_query DB "SELECT * FROM customers WHERE id = ?" [customer-id])))

;; 고객 목록 "지역" 컬럼용 — 주소 앞 두 토큰(시/도 + 시/군/구)만 잘라서 보여준다.
;; 토큰이 2개 미만이면 주소 원문을 그대로 노출한다 (docs/05 33장).
(defn parse-region [address]
  (if (or (nil? address) (str-blank? address))
    ""
    (let [parts (str-split address " ")]
      (if (>= (length parts) 2)
        (str (nth parts 0) " " (nth parts 1))
        address))))

(defn create-site [customer-id name address contact-phone]
  (do
    (db_exec DB
      "INSERT INTO sites (customer_id, name, address, contact_phone) VALUES (?, ?, ?, ?)"
      [customer-id name address contact-phone])
    (let [id (inserted-id "sites")]
      (first (db_query DB "SELECT * FROM sites WHERE id = ?" [id])))))

(defn create-equipment [site-id contract-id category model serial-number installed-at warranty-ends-at]
  (do
    (db_exec DB
      "INSERT INTO equipment
       (site_id, contract_id, category, model, serial_number, installed_at, warranty_ends_at)
       VALUES (?, ?, ?, ?, ?, ?, ?)"
      [site-id contract-id category model serial-number installed-at warranty-ends-at])
    (let [id (inserted-id "equipment")]
      (first (db_query DB "SELECT * FROM equipment WHERE id = ?" [id])))))

(defn issue-ticket-token []
  (let [raw-token (random_bytes 32)]
    {:raw_token raw-token
     :token_hash (sha256 raw-token)
     :token_identifier (sha256_short raw-token)}))

(defn create-service-ticket [site-id equipment-id symptom priority source scheduled-at]
  (let [token (issue-ticket-token)]
    (db_exec DB
      "INSERT INTO service_tickets
       (site_id, equipment_id, symptom, priority, source, status, scheduled_at, public_token_hash)
       VALUES (?, ?, ?, ?, ?, 'RECEIVED', ?, ?)"
      [site-id equipment-id symptom priority source scheduled-at (get token :token_hash)])
    (let [id (inserted-id "service_tickets")]
      {:id id
       :status TICKET-RECEIVED
       :public_token (get token :raw_token)})))

(defn valid-ticket-transition? [from to]
  (cond
    [(= from TICKET-RECEIVED)
     (or (= to TICKET-SCHEDULED) (= to TICKET-IN-PROGRESS) (= to TICKET-CANCELLED))]
    [(= from TICKET-SCHEDULED)
     (or (= to TICKET-IN-PROGRESS) (= to TICKET-CANCELLED))]
    [(= from TICKET-IN-PROGRESS)
     (or (= to TICKET-COMPLETED) (= to TICKET-CANCELLED))]
    [true false]))

;; 완료(COMPLETED) 티켓은 이 기간 동안은 공개 링크로 계속 조회 가능하다 — 고객이
;; "완료됐다"는 걸 실제로 확인할 수 있어야 하므로 완료 즉시 폐기하지 않는다.
(define TICKET-COMPLETED-VISIBILITY-DAYS 7)

(defn update-ticket-status [ticket-id new-status]
  (let [rows (db_query DB "SELECT status FROM service_tickets WHERE id = ?" [ticket-id])]
    (if (= (length rows) 0) (error "Service ticket not found"))
    (let [old-status (get (first rows) :status)]
      (if (not (valid-ticket-transition? old-status new-status))
        (error "Invalid service ticket status transition"))
      (cond
        [(= new-status TICKET-CANCELLED)
         ;; 취소는 더 볼 이유가 없으니 즉시 폐기한다.
         (db_exec DB
           "UPDATE service_tickets
            SET status = ?, closed_at = CURRENT_TIMESTAMP,
                public_token_revoked_at = CURRENT_TIMESTAMP,
                updated_at = CURRENT_TIMESTAMP
            WHERE id = ?"
           [new-status ticket-id])]
        [(= new-status TICKET-COMPLETED)
         ;; 완료는 closed_at만 찍고 토큰은 즉시 폐기하지 않는다 — 고객이 완료 상태를
         ;; 확인할 시간을 준다. TICKET-COMPLETED-VISIBILITY-DAYS 이후엔
         ;; get-public-ticket이 시간 기준으로 자동 만료 처리한다.
         (db_exec DB
           "UPDATE service_tickets
            SET status = ?, closed_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP
            WHERE id = ?"
           [new-status ticket-id])]
        [true
         (db_exec DB
           "UPDATE service_tickets SET status = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?"
           [new-status ticket-id])])
      {:success true :old_status old-status :new_status new-status})))

(defn add-service-visit [ticket-id technician visited-at diagnosis action-taken parts-used labor-cost parts-cost next-inspection-at]
  (do
    (db_exec DB
      "INSERT INTO service_visits
       (ticket_id, technician, visited_at, diagnosis, action_taken, parts_used,
        labor_cost, parts_cost, next_inspection_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)"
      [ticket-id technician visited-at diagnosis action-taken parts-used
       labor-cost parts-cost next-inspection-at])
    (let [id (inserted-id "service_visits")]
      (first (db_query DB "SELECT * FROM service_visits WHERE id = ?" [id])))))

(defn revoke-public-link [ticket-id]
  (do
    (db_exec DB
      "UPDATE service_tickets SET public_token_revoked_at = CURRENT_TIMESTAMP,
       updated_at = CURRENT_TIMESTAMP WHERE id = ?"
      [ticket-id])
    true))

(defn reissue-public-link [ticket-id]
  (let [rows (db_query DB "SELECT status FROM service_tickets WHERE id = ?" [ticket-id])]
    (if (= (length rows) 0) (error "Service ticket not found"))
    (if (or (= (get (first rows) :status) TICKET-COMPLETED)
            (= (get (first rows) :status) TICKET-CANCELLED))
      (error "Closed service ticket cannot receive a new public link"))
    (let [token (issue-ticket-token)]
      (db_exec DB
        "UPDATE service_tickets
         SET public_token_hash = ?, public_token_revoked_at = NULL,
             updated_at = CURRENT_TIMESTAMP WHERE id = ?"
        [(get token :token_hash) ticket-id])
      {:ticket_id ticket-id :public_token (get token :raw_token)})))

(defn prune-link-access-logs []
  (do
    (db_exec DB
      "DELETE FROM link_access_logs WHERE accessed_at < datetime('now', '-90 days')"
      [])
    true))

(defn public-ip-rate-limited? [ip-address]
  (let [rows (db_query DB
               "SELECT COUNT(*) AS count FROM link_access_logs
                WHERE ip_address = ?
                  AND accessed_at >= datetime('now', '-1 minute')"
               [ip-address])]
    (>= (get (first rows) :count) 60)))

(defn public-token-rate-limited? [token-identifier]
  (let [rows (db_query DB
               "SELECT COUNT(*) AS count FROM link_access_logs
                WHERE token_identifier = ?
                  AND accessed_at >= datetime('now', '-1 minute')"
               [token-identifier])]
    (>= (get (first rows) :count) 20)))

(defn log-public-link-access [ticket-id token-identifier ip-address outcome]
  (db_exec DB
    "INSERT INTO link_access_logs
     (ticket_id, token_identifier, ip_address, access_outcome) VALUES (?, ?, ?, ?)"
    [ticket-id token-identifier ip-address outcome]))

(defn get-public-ticket [raw-token ip-address]
  (do
    (prune-link-access-logs)
    (let [token-hash (sha256 raw-token)
          token-identifier (sha256_short raw-token)]
      (if (public-ip-rate-limited? ip-address)
        (do
          (log-public-link-access nil token-identifier ip-address "RATE_LIMITED")
          {:result "RATE_LIMITED"})
        (let [rows (db_query DB
                     (str
                       "SELECT t.id, t.status, t.scheduled_at,
                               s.name AS site_name, s.contact_phone
                        FROM service_tickets t
                        JOIN sites s ON s.id = t.site_id
                        WHERE t.public_token_hash = ?
                          AND t.public_token_revoked_at IS NULL
                          AND (t.status <> 'COMPLETED'
                               OR t.closed_at >= datetime('now', '-"
                       TICKET-COMPLETED-VISIBILITY-DAYS
                       " days'))
                        LIMIT 1")
                     [token-hash])]
          (if (= (length rows) 0)
            (do
              (log-public-link-access nil token-identifier ip-address "NOT_FOUND")
              nil)
            (if (public-token-rate-limited? token-identifier)
              (do
                (log-public-link-access (get (first rows) :id) token-identifier ip-address "RATE_LIMITED")
                {:result "RATE_LIMITED"})
              (let [ticket (first rows)]
                (log-public-link-access (get ticket :id) token-identifier ip-address "OK")
                {:status (get ticket :status)
                 :scheduled_at (get ticket :scheduled_at)
                 :site_name (get ticket :site_name)
                 :contact_phone (get ticket :contact_phone)}))))))))

(defn list-customer-sites [customer-id]
  (db_query DB
    "SELECT id, name, address, contact_phone, status FROM sites
     WHERE customer_id = ? ORDER BY name"
    [customer-id]))

(defn list-customer-equipment [customer-id]
  (db_query DB
    "SELECT e.id, e.site_id, e.category, e.model, e.serial_number,
            e.installed_at, e.warranty_ends_at, e.status, s.name AS site_name
     FROM equipment e
     JOIN sites s ON s.id = e.site_id
     WHERE s.customer_id = ?
     ORDER BY e.installed_at DESC, e.id DESC"
    [customer-id]))

(defn list-customer-contracts [customer-id]
  (db_query DB
    "SELECT id, number, status, amount, created_at, updated_at
     FROM contracts
     WHERE customer_id = ?
     ORDER BY created_at DESC, id DESC"
    [customer-id]))

(defn valid-quote-transition? [from to]
  (cond
    [(= from "DRAFT") (= to "SENT")]
    [(= from "SENT")
     (or (= to "REVIEWING") (= to "ON_HOLD") (= to "REJECTED"))]
    [(= from "REVIEWING")
     (or (= to "REVISION_REQUESTED") (= to "APPROVED")
         (= to "ON_HOLD") (= to "REJECTED"))]
    [(= from "REVISION_REQUESTED")
     (or (= to "SENT") (= to "ON_HOLD") (= to "REJECTED"))]
    [(= from "ON_HOLD") (= to "REVIEWING")]
    [true false]))

(defn create-quote [customer-id title amount valid-until memo]
  (let [number (generate-doc-number "QT")]
    (db_exec DB
      "INSERT INTO quotes (customer_id, quote_number, title, amount, valid_until, memo)
       VALUES (?, ?, ?, ?, ?, ?)"
      [customer-id number title amount valid-until memo])
    (let [id (inserted-id "quotes")]
      (first (db_query DB "SELECT * FROM quotes WHERE id = ?" [id])))))

(defn list-customer-quotes [customer-id]
  (db_query DB
    "SELECT * FROM quotes WHERE customer_id = ? ORDER BY created_at DESC, id DESC"
    [customer-id]))

(defn update-quote-status [quote-id new-status]
  (let [rows (db_query DB "SELECT status FROM quotes WHERE id = ?" [quote-id])]
    (if (= (length rows) 0) (error "Quote not found"))
    (let [current (get (first rows) :status)]
      (if (not (valid-quote-transition? current new-status))
        (error "Invalid quote status transition"))
      (cond
        [(= new-status "SENT")
         (db_exec DB
           "UPDATE quotes
            SET status = ?, sent_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP
            WHERE id = ?"
           [new-status quote-id])]
        [true
         (db_exec DB
           "UPDATE quotes SET status = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?"
           [new-status quote-id])])
      (first (db_query DB "SELECT * FROM quotes WHERE id = ?" [quote-id])))))

(defn convert-quote-to-contract [quote-id]
  (let [rows (db_query DB "SELECT * FROM quotes WHERE id = ?" [quote-id])]
    (if (= (length rows) 0) (error "Quote not found"))
    (let [quote (first rows)]
      (if (not (= (get quote :status) "APPROVED"))
        (error "Only APPROVED quotes can be converted to a contract"))
      (db_exec DB "BEGIN TRANSACTION" [])
      (try
        (let [contract-number (generate-doc-number "CTR")
              shadow-client-id (resolve-shadow-client-id (get quote :customer_id))]
          (db_exec DB
            "INSERT INTO contracts (number, status, client_id, customer_id, amount)
             VALUES (?, 'DRAFT', ?, ?, ?)"
            [contract-number shadow-client-id (get quote :customer_id) (get quote :amount)])
          (let [contract-id (inserted-id "contracts")]
            (db_exec DB
              "UPDATE quotes
               SET status = 'CONVERTED', contract_id = ?, updated_at = CURRENT_TIMESTAMP
               WHERE id = ?"
              [contract-id quote-id])
            (db_exec DB "COMMIT" [])
            (first (db_query DB "SELECT * FROM quotes WHERE id = ?" [quote-id]))))
        (catch [e]
          (try (db_exec DB "ROLLBACK" []) (catch [re] false))
          (error (str "Quote conversion failed: " e)))))))

(defn list-customer-tickets [customer-id]
  (db_query DB
    "SELECT t.id, t.site_id, t.equipment_id, t.symptom, t.priority, t.source,
            t.status, t.scheduled_at, t.created_at, s.name AS site_name
     FROM service_tickets t
     JOIN sites s ON s.id = t.site_id
     WHERE s.customer_id = ?
     ORDER BY t.created_at DESC, t.id DESC"
    [customer-id]))

(defn list-site-tickets [site-id]
  (db_query DB
    "SELECT id, equipment_id, symptom, priority, source, status, scheduled_at, created_at
     FROM service_tickets WHERE site_id = ? ORDER BY created_at DESC"
    [site-id]))

;; Admin UI용 목록/검색. 내부용이라 원가·증상 등 상세도 그대로 반환한다(공개 응답과는
;; 다르게 최소노출 원칙을 적용하지 않음 — internal-authorized? 뒤에서만 호출되므로).
(defn list-tickets-by-status [status today-only?]
  (if today-only?
    (db_query DB
      "SELECT t.id, t.site_id, t.equipment_id, t.symptom, t.priority, t.source,
              t.status, t.scheduled_at, t.created_at, s.name AS site_name, s.contact_phone
       FROM service_tickets t JOIN sites s ON s.id = t.site_id
       WHERE t.status = ? AND date(t.created_at) = date('now')
       ORDER BY t.created_at DESC"
      [status])
    (db_query DB
      "SELECT t.id, t.site_id, t.equipment_id, t.symptom, t.priority, t.source,
              t.status, t.scheduled_at, t.created_at, s.name AS site_name, s.contact_phone
       FROM service_tickets t JOIN sites s ON s.id = t.site_id
       WHERE t.status = ?
       ORDER BY t.created_at DESC"
      [status])))

(defn get-ticket-detail [ticket-id]
  (let [ticket (first (db_query DB
                 "SELECT t.*, s.name AS site_name, s.contact_phone, s.address,
                         c.id AS customer_id, c.name AS customer_name
                  FROM service_tickets t
                  JOIN sites s ON s.id = t.site_id
                  JOIN customers c ON c.id = s.customer_id
                  WHERE t.id = ?"
                 [ticket-id]))]
    (if (nil? ticket)
      nil
      {:ticket ticket
       :visits (db_query DB
                 "SELECT * FROM service_visits WHERE ticket_id = ? ORDER BY visited_at"
                 [ticket-id])
       :history (db_query DB
                  "SELECT old_status, new_status, changed_at FROM service_ticket_history
                   WHERE ticket_id = ? ORDER BY changed_at"
                  [ticket-id])})))

(defn search-customers [query customer-filter]
  (let [resolved-filter (if (or (nil? customer-filter) (str-blank? customer-filter)) "ALL" customer-filter)]
    (if (not (valid-customer-filter? resolved-filter))
      (error "filter must be one of ALL, LEAD, CUSTOMER, SERVICE, VENDOR"))
    (let [normalized-query (str-replace (str-replace query "-" "") " " "")
          rows (db_query DB
                 "SELECT c.id, c.name, c.phone, c.email, c.address, c.customer_type, c.migration_status,
                         (SELECT s.name FROM sites s
                          WHERE s.customer_id = c.id
                          ORDER BY s.id ASC LIMIT 1) AS site_name,
                         (SELECT co.consulted_at
                          FROM consultations co
                          WHERE co.customer_id = c.id
                          ORDER BY co.consulted_at DESC, co.id DESC LIMIT 1) AS last_consulted_at,
                         (SELECT co.next_contact_at
                          FROM consultations co
                          WHERE co.customer_id = c.id
                            AND co.completed_at IS NULL
                            AND co.next_contact_at IS NOT NULL
                          ORDER BY co.next_contact_at ASC, co.id DESC LIMIT 1) AS next_contact_at
                  FROM customers c
                  WHERE (? = 'ALL' OR c.customer_type = ?)
                    AND (? = ''
                         OR c.name LIKE ?
                         OR c.phone LIKE ?
                         OR c.address LIKE ?
                         OR c.memo LIKE ?
                         OR REPLACE(REPLACE(c.phone, '-', ''), ' ', '') LIKE ?)
                  ORDER BY c.name LIMIT 50"
                 [resolved-filter resolved-filter query
                  (str "%" query "%") (str "%" query "%") (str "%" query "%") (str "%" query "%")
                  (str "%" normalized-query "%")])]
      (map (fn [row] (assoc row :region (parse-region (get row :address)))) rows))))

;; ---- 부품판매 (매출 30%, A/S와 독립적으로도 발생) ----

(defn create-part-sale [site-id equipment-id ticket-id part-name quantity unit-price channel]
  (let [total (* quantity unit-price)]
    (db_exec DB
      "INSERT INTO part_sales
       (site_id, equipment_id, ticket_id, part_name, quantity, unit_price, total_price, channel)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)"
      [site-id equipment-id ticket-id part-name quantity unit-price total channel])
    (let [id (inserted-id "part_sales")]
      (first (db_query DB "SELECT * FROM part_sales WHERE id = ?" [id])))))

(defn list-site-part-sales [site-id]
  (db_query DB
    "SELECT * FROM part_sales WHERE site_id = ? ORDER BY sold_at DESC"
    [site-id]))

(defn list-customer-part-sales [customer-id]
  (db_query DB
    "SELECT p.id, p.site_id, p.equipment_id, p.ticket_id, p.part_name, p.quantity,
            p.unit_price, p.total_price, p.channel, p.sold_at, s.name AS site_name
     FROM part_sales p
     JOIN sites s ON s.id = p.site_id
     WHERE s.customer_id = ?
     ORDER BY p.sold_at DESC, p.id DESC"
    [customer-id]))

;; ---- 고객 타임라인 ----

(defn valid-timeline-type? [event-type]
  (or (= event-type "ALL")
      (= event-type "CONSULTATION")
      (= event-type "SALE")
      (= event-type "QUOTE")
      (= event-type "CONTRACT")
      (= event-type "TICKET")
      (= event-type "FOLLOWUP")))

(defn list-customer-timeline [customer-id event-type]
  (let [resolved-type (if (or (nil? event-type) (str-blank? event-type)) "ALL" event-type)]
    (if (not (valid-timeline-type? resolved-type))
      (error "type must be one of ALL, CONSULTATION, SALE, QUOTE, CONTRACT, TICKET, FOLLOWUP"))
    (db_query DB
      "SELECT * FROM (
         SELECT 'CONSULTATION' AS event_type, datetime(consulted_at) AS event_at,
                (method || ' 상담') AS title, content AS detail, id AS source_id
         FROM consultations WHERE customer_id = ?

         UNION ALL
         SELECT 'SALE', datetime(p.sold_at),
                (p.part_name || ' ' || p.quantity || '개'),
                ('총액 ' || p.total_price || '원'), p.id
         FROM part_sales p
         JOIN sites s ON s.id = p.site_id
         WHERE s.customer_id = ?

         UNION ALL
         SELECT 'QUOTE', datetime(created_at), title,
                ('금액 ' || amount || '원 / 상태 ' || status), id
         FROM quotes WHERE customer_id = ?

         UNION ALL
         SELECT 'CONTRACT', datetime(created_at), ('계약 ' || number),
                ('금액 ' || amount || '원 / 상태 ' || status), id
         FROM contracts WHERE customer_id = ?

         UNION ALL
         SELECT 'TICKET', datetime(t.created_at), t.symptom,
                ('상태 ' || t.status), t.id
         FROM service_tickets t
         JOIN sites s ON s.id = t.site_id
         WHERE s.customer_id = ?

         UNION ALL
         SELECT 'FOLLOWUP', datetime(scheduled_at), followup_type,
                COALESCE(result, ''), id
         FROM customer_followups WHERE customer_id = ?
       )
       WHERE (? = 'ALL' OR event_type = ?)
       ORDER BY event_at DESC, event_type, source_id DESC"
      [customer-id customer-id customer-id customer-id customer-id customer-id
       resolved-type resolved-type])))

;; ---- 휴면기 관리·홍보 (활동 20%, 판매 후 ~3년 동안 가장 자주 도는 흐름) ----

(defn create-outreach-touch [site-id equipment-id touch-type channel next-touch-at]
  (do
    (db_exec DB
      "INSERT INTO outreach_touches (site_id, equipment_id, touch_type, channel, next_touch_at)
       VALUES (?, ?, ?, ?, ?)"
      [site-id equipment-id touch-type channel next-touch-at])
    (let [id (inserted-id "outreach_touches")]
      (first (db_query DB "SELECT * FROM outreach_touches WHERE id = ?" [id])))))

;; 접촉 기록: 응답과 전환 여부를 남기고, 전환 안 됐으면 다음 접촉일을 갱신한다.
;; converted-to가 있으면 next-touch-at 없이 이 라운드를 종결한다(전환됐으니 재접촉 불필요).
(defn record-outreach-response [touch-id response converted-to converted-ref-id next-touch-at]
  (do
    (db_exec DB
      "UPDATE outreach_touches
       SET sent_at = CURRENT_TIMESTAMP, response = ?, converted_to = ?,
           converted_ref_id = ?, next_touch_at = ?
       WHERE id = ?"
      [response converted-to converted-ref-id next-touch-at touch-id])
    (first (db_query DB "SELECT * FROM outreach_touches WHERE id = ?" [touch-id]))))

;; 오늘 기준 접촉이 밀린(또는 예정된) 대상 목록 — Admin UI "홍보 대상" 화면용.
(defn list-due-outreach []
  (db_query DB
    "SELECT o.id, o.site_id, o.equipment_id, o.touch_type, o.channel,
            o.next_touch_at, s.name AS site_name, s.contact_phone
     FROM outreach_touches o
     JOIN sites s ON s.id = o.site_id
     WHERE o.next_touch_at IS NOT NULL AND o.next_touch_at <= datetime('now')
       AND o.id IN (
         SELECT MAX(id) FROM outreach_touches GROUP BY site_id, equipment_id
       )
     ORDER BY o.next_touch_at"
    []))

;; ---- 판매 관리 (활동 40%, 기존 계약 연결부터 후속 운영까지 단일 트랜잭션으로 orchestrate) ----
;; 기존 계약 연결 -> 고객/사업장 생성 -> 장비 등록 -> 장비관리 링크 발급 -> 첫 접촉 예약.
;; customer-id가 있으면 기존 고객 재사용, 없으면 새로 만든다.
(defn bounded-days [value default-value field-name]
  (let [resolved (if (nil? value) default-value value)
        raw (str resolved)]
    (if (not (regex_match raw "^[0-9]{1,4}$"))
      (error (str field-name " must be an integer between 0 and 3650")))
    (let [days (int raw)]
      (if (or (< days 0) (> days 3650))
        (error (str field-name " must be an integer between 0 and 3650")))
      days)))

(defn register-sale [customer-id customer-name customer-phone customer-email
                      site-name site-address site-contact-phone
                      contract-id equipment-list first-outreach-days]
  (let [outreach-days (bounded-days first-outreach-days 90 "first_outreach_days")]
    (db_exec DB "BEGIN TRANSACTION" [])
    (try
      (let [resolved-customer-id
              (if (not (nil? customer-id))
                customer-id
                (get (create-customer customer-name customer-phone customer-email "" "CUSTOMER" site-address) :id))
            site-token (random_bytes 32)
            site-token-hash (sha256 site-token)]
        (db_exec DB
          "INSERT INTO sites (customer_id, name, address, contact_phone, public_token_hash)
           VALUES (?, ?, ?, ?, ?)"
          [resolved-customer-id site-name site-address site-contact-phone site-token-hash])
        (let [site-id (inserted-id "sites")
              created-equipment
                (map
                  (fn [item]
                    (create-equipment site-id contract-id
                      (get item :category) (get item :model) (get item :serial_number)
                      (get item :installed_at) (get item :warranty_ends_at)))
                  equipment-list)]
          (db_exec DB
            "INSERT INTO outreach_touches
             (site_id, equipment_id, touch_type, channel, next_touch_at)
             VALUES (?, NULL, 'CHECKIN', 'PHONE', datetime('now', ?))"
            [site-id (str "+" outreach-days " days")])
          (let [result {:customer_id resolved-customer-id
                        :site_id site-id
                        :equipment created-equipment
                        :site_public_token site-token}]
            (db_exec DB "COMMIT" [])
            result)))
      (catch [e]
        (do
          (try
            (db_exec DB "ROLLBACK" [])
            (catch [rollback-error] false))
          (error (str "Sale registration failed: " e)))))))

;; ---- 장비관리 링크 (사업장 단위 공개 조회, 티켓 단위 공개 링크와는 별개) ----
(defn get-site-public-view [raw-token ip-address]
  (do
    (prune-link-access-logs)
    (let [token-hash (sha256 raw-token)
          token-identifier (sha256_short raw-token)]
      (if (public-ip-rate-limited? ip-address)
        (do
          (log-public-link-access nil token-identifier ip-address "RATE_LIMITED")
          {:result "RATE_LIMITED"})
        (let [rows (db_query DB
                     "SELECT id, name, contact_phone FROM sites
                      WHERE public_token_hash = ? AND public_token_revoked_at IS NULL
                      LIMIT 1"
                     [token-hash])]
          (if (= (length rows) 0)
            (do
              (log-public-link-access nil token-identifier ip-address "NOT_FOUND")
              nil)
            (if (public-token-rate-limited? token-identifier)
              (do
                (log-public-link-access nil token-identifier ip-address "RATE_LIMITED")
                {:result "RATE_LIMITED"})
              (let [site (first rows)]
                (log-public-link-access nil token-identifier ip-address "OK")
                {:site_name (get site :name)
                 :contact_phone (get site :contact_phone)
                 :equipment (db_query DB
                              "SELECT category, model, installed_at, warranty_ends_at, status
                               FROM equipment WHERE site_id = ? ORDER BY installed_at"
                              [(get site :id)])}))))))))

(defn find-site [site-id]
  (let [rows (db_query DB "SELECT id FROM sites WHERE id = ?" [site-id])]
    (if (= (length rows) 0) nil (first rows))))

(defn revoke-site-link [site-id]
  (if (nil? (find-site site-id))
    false
    (do
      (db_exec DB
        "UPDATE sites SET public_token_revoked_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP
         WHERE id = ?"
        [site-id])
      true)))

(defn reissue-site-link [site-id]
  (if (nil? (find-site site-id))
    nil
    (let [raw-token (random_bytes 32)
          token-hash (sha256 raw-token)]
      (db_exec DB
        "UPDATE sites SET public_token_hash = ?, public_token_revoked_at = NULL,
         updated_at = CURRENT_TIMESTAMP WHERE id = ?"
        [token-hash site-id])
      {:site_id site-id :site_public_token raw-token})))

;; ---- 보증 만료 임박 (판매 관리 대시보드용, 재구매·교체판매 트리거 후보) ----
;; 2026-07-21: 운영집계(ops-summary)와 공유하는 로직이라 ACTIVE 장비만 대상으로
;; 좁혔다(RETIRED/REPAIR 장비는 재구매 제안 대상이 아님 — docs/09 2주차 확정 규칙).
;; 목록은 다른 운영 목록과 동일하게 최대 50건으로 캡한다.
(defn list-warranty-expiring [days]
  (let [window-days (bounded-days days 30 "days")]
    (db_query DB
      "SELECT e.id, e.model, e.category, e.warranty_ends_at, e.status,
              s.id AS site_id, s.name AS site_name, s.contact_phone
       FROM equipment e
       JOIN sites s ON s.id = e.site_id
       WHERE e.status = 'ACTIVE'
         AND e.warranty_ends_at IS NOT NULL
         AND date(e.warranty_ends_at) >= date('now', '+9 hours')
         AND date(e.warranty_ends_at) <= date('now', '+9 hours', ?)
       ORDER BY e.warranty_ends_at
       LIMIT 50"
      [(str "+" window-days " days")])))

(defn count-warranty-expiring [days]
  (let [window-days (bounded-days days 30 "days")]
    (get (first (db_query DB
      "SELECT COUNT(*) AS c
       FROM equipment e
       WHERE e.status = 'ACTIVE'
         AND e.warranty_ends_at IS NOT NULL
         AND date(e.warranty_ends_at) >= date('now', '+9 hours')
         AND date(e.warranty_ends_at) <= date('now', '+9 hours', ?)"
      [(str "+" window-days " days")])) :c)))

;; ---- 운영 대시보드 집계 (2주차, docs/09 §3 — 미수금 제외, 담당자 배정 컬럼 없음) ----
;;
;; 확정 규칙(Codex, 2026-07-21):
;;  - overdue(지연): scheduled_at 있고 status IN (RECEIVED,SCHEDULED)이며
;;    Seoul 기준 현재시각보다 과거(strict <, 동일 시각은 지연 아님)
;;  - unscheduled(일정 미정): scheduled_at 없고 status IN (RECEIVED,SCHEDULED).
;;    "담당자 미배정"이 아니다 — service_tickets에 담당자 컬럼이 없고
;;    service_visits.technician은 방문 완료 후에만 존재하는 사후 이력이라
;;    배정 여부를 나타낼 수 없다(신규 컬럼 도입 전까지 이 명칭·정의를 쓰지 않는다).
;;  - visits_today(오늘 방문): Seoul 오늘 날짜의 scheduled_at(예정), 완료/취소 제외.
;;    service_visits(방문 완료 이력)는 여기 쓰지 않는다 — "오늘 나갈 일"이지
;;    "오늘 끝난 일"이 아니다.
;;  - warranty_expiring: 위 list-warranty-expiring/count-warranty-expiring 재사용
;;    (이미 ACTIVE 필터 적용됨).
;; 모든 "지금"은 (datetime|date)('now', '+9 hours')로 Seoul 달력을 근사한다 —
;; SQLite 기본 now()는 UTC라서 보정 없이는 자정 근처 티켓이 하루 어긋난다.

(defn count-ops-overdue []
  (get (first (db_query DB
    "SELECT COUNT(*) AS c
     FROM service_tickets t
     WHERE t.status IN ('RECEIVED', 'SCHEDULED')
       AND t.scheduled_at IS NOT NULL AND trim(t.scheduled_at) <> ''
       AND datetime(t.scheduled_at) < datetime('now', '+9 hours')"
    [])) :c))

(defn list-ops-overdue []
  (db_query DB
    "SELECT t.id, t.site_id, t.symptom, t.priority, t.status, t.scheduled_at,
            s.name AS site_name, s.contact_phone
     FROM service_tickets t
     JOIN sites s ON s.id = t.site_id
     WHERE t.status IN ('RECEIVED', 'SCHEDULED')
       AND t.scheduled_at IS NOT NULL AND trim(t.scheduled_at) <> ''
       AND datetime(t.scheduled_at) < datetime('now', '+9 hours')
     ORDER BY t.scheduled_at ASC, t.id ASC
     LIMIT 50"
    []))

(defn count-ops-unscheduled []
  (get (first (db_query DB
    "SELECT COUNT(*) AS c
     FROM service_tickets t
     WHERE t.status IN ('RECEIVED', 'SCHEDULED')
       AND (t.scheduled_at IS NULL OR trim(t.scheduled_at) = '')"
    [])) :c))

(defn list-ops-unscheduled []
  (db_query DB
    "SELECT t.id, t.site_id, t.symptom, t.priority, t.status, t.scheduled_at,
            s.name AS site_name, s.contact_phone
     FROM service_tickets t
     JOIN sites s ON s.id = t.site_id
     WHERE t.status IN ('RECEIVED', 'SCHEDULED')
       AND (t.scheduled_at IS NULL OR trim(t.scheduled_at) = '')
     ORDER BY t.id DESC
     LIMIT 50"
    []))

(defn count-ops-visits-today []
  (get (first (db_query DB
    "SELECT COUNT(*) AS c
     FROM service_tickets t
     WHERE t.status NOT IN ('COMPLETED', 'CANCELLED')
       AND t.scheduled_at IS NOT NULL AND trim(t.scheduled_at) <> ''
       AND date(t.scheduled_at) = date('now', '+9 hours')"
    [])) :c))

(defn list-ops-visits-today []
  (db_query DB
    "SELECT t.id, t.site_id, t.symptom, t.priority, t.status, t.scheduled_at,
            s.name AS site_name, s.contact_phone
     FROM service_tickets t
     JOIN sites s ON s.id = t.site_id
     WHERE t.status NOT IN ('COMPLETED', 'CANCELLED')
       AND t.scheduled_at IS NOT NULL AND trim(t.scheduled_at) <> ''
       AND date(t.scheduled_at) = date('now', '+9 hours')
     ORDER BY t.scheduled_at ASC, t.id ASC
     LIMIT 50"
    []))

(defn ops-summary-as-of []
  (str-replace
    (get (first (db_query DB "SELECT datetime('now', '+9 hours') AS as_of" [])) :as_of)
    " " "T"))

(defn get-ops-summary [warranty-days]
  (let [window-days (bounded-days warranty-days 30 "warranty_days")]
    {:as_of (str (ops-summary-as-of) "+09:00")
     :timezone "Asia/Seoul"
     :overdue {:count (count-ops-overdue) :items (list-ops-overdue)}
     :unscheduled {:count (count-ops-unscheduled) :items (list-ops-unscheduled)}
     :visits_today {:count (count-ops-visits-today) :items (list-ops-visits-today)}
     :warranty_expiring {:count (count-warranty-expiring window-days)
                          :days window-days
                          :items (list-warranty-expiring window-days)}}))

;; ---- 주간 운영보고 (3주차, docs/09 §4 — 미수금 제외, week/inspection_days 파라미터
;; 없음, 신규 인덱스 없음. 2주차 (status,scheduled_at) 인덱스·상태 필터·Asia/Seoul
;; 보정 관용구를 그대로 재사용) ----
;;
;; SQLite date()/strftime()는 ISO 8601 주차(%G/%V)를 지원하지 않으므로
;; 월요일 계산 + "목요일 트릭"(어떤 주의 목요일은 항상 그 주의 ISO 연도에
;; 속한다는 성질)으로 직접 계산한다 — 이렇게 하면 연말연초 경계
;; (예: 2025-12-29~2026-01-04는 2026-W01, 2026년은 53주짜리 해)가 자동으로
;; 맞아떨어진다.

;; 날짜 문자열이 속한 주의 월요일. iso_dow = ((%w+6)%7)+1(월=1..일=7)이므로
;; 월요일까지 되돌릴 일수는 (%w+6)%7.
(defn iso-monday-of [date-str]
  (get (first (db_query DB
    "SELECT date(?, '-' || ((CAST(strftime('%w', ?) AS INTEGER) + 6) % 7) || ' days') AS v"
    [date-str date-str])) :v))

;; 월요일 날짜 → 그 주의 ISO 연도·주차. monday+3일(목요일)의 연도가 곧 ISO
;; 연도이고, 그 목요일의 연중 일수(day-of-year)를 7로 나눈 몫+1이 주차다.
(defn iso-year-week-of [monday-str]
  (let [row (first (db_query DB
              "SELECT strftime('%Y', date(?, '+3 days')) AS iso_year,
                      ((CAST(strftime('%j', date(?, '+3 days')) AS INTEGER) - 1) / 7) + 1 AS iso_week"
              [monday-str monday-str]))]
    {:iso_year (int (get row :iso_year))
     :iso_week (get row :iso_week)}))

(defn iso-week-label [iso-year iso-week]
  (str iso-year "-W" (if (< iso-week 10) (str "0" iso-week) (str iso-week))))

;; as-of(YYYY-MM-DD, 이미 검증됨)가 속한 주의 "다음" ISO 주 정보.
;; start_date/end_date는 둘 다 포함 경계(월요일~일요일).
(defn next-iso-week-info [as-of]
  (let [this-monday (iso-monday-of as-of)
        next-monday (get (first (db_query DB "SELECT date(?, '+7 days') AS v" [this-monday])) :v)
        yw (iso-year-week-of next-monday)
        end-date (get (first (db_query DB "SELECT date(?, '+6 days') AS v" [next-monday])) :v)]
    {:kind "next"
     :iso_year (get yw :iso_year)
     :iso_week (get yw :iso_week)
     :label (iso-week-label (get yw :iso_year) (get yw :iso_week))
     :start_date next-monday
     :end_date end-date}))

;; 형식(YYYY-MM-DD) + 실존 여부(round-trip: date(x)=x — SQLite는 2026-02-30
;; 같은 값을 조용히 다음달로 정규화하므로 원문과 재비교해야 걸러진다)를
;; 모두 만족해야 유효한 달력 날짜로 인정한다.
(defn valid-calendar-date? [date-str]
  (and (regex_match date-str "^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
       (= (get (first (db_query DB "SELECT date(?) = ? AS v" [date-str date-str])) :v) 1)))

(defn resolve-ops-weekly-as-of [as-of]
  (let [resolved (if (or (nil? as-of) (str-blank? as-of))
                   (get (first (db_query DB "SELECT date('now', '+9 hours') AS v" [])) :v)
                   as-of)]
    (if (not (valid-calendar-date? resolved))
      (error "as_of must be a valid YYYY-MM-DD date"))
    resolved))

;; 미처리 A/S: status만으로 판정하는 현재 상태 전체 스냅샷(생성일 필터 없음).
;; COMPLETED/CANCELLED만 제외하므로 RECEIVED/SCHEDULED/IN_PROGRESS 전부 포함.
(defn count-ops-weekly-unprocessed []
  (get (first (db_query DB
    "SELECT COUNT(*) AS c FROM service_tickets WHERE status NOT IN ('COMPLETED', 'CANCELLED')"
    [])) :c))

(defn list-ops-weekly-unprocessed []
  (db_query DB
    "SELECT t.id, t.site_id, t.symptom, t.priority, t.status, t.scheduled_at,
            s.name AS site_name, s.contact_phone
     FROM service_tickets t
     JOIN sites s ON s.id = t.site_id
     WHERE t.status NOT IN ('COMPLETED', 'CANCELLED')
     ORDER BY (t.scheduled_at IS NULL OR trim(t.scheduled_at) = ''), t.scheduled_at ASC, t.id ASC
     LIMIT 50"
    []))

;; 다음 주 방문: [start-date, end-date-exclusive) 반열림 구간의 scheduled_at.
;; service_visits(완료 이력)는 쓰지 않는다 — 아직 안 나간 예정 방문이다.
(defn count-ops-weekly-visits [start-date end-date-exclusive]
  (get (first (db_query DB
    "SELECT COUNT(*) AS c
     FROM service_tickets t
     WHERE t.status NOT IN ('COMPLETED', 'CANCELLED')
       AND t.scheduled_at IS NOT NULL AND trim(t.scheduled_at) <> ''
       AND date(t.scheduled_at) >= ? AND date(t.scheduled_at) < ?"
    [start-date end-date-exclusive])) :c))

(defn list-ops-weekly-visits [start-date end-date-exclusive]
  (db_query DB
    "SELECT t.id, t.site_id, t.symptom, t.priority, t.status, t.scheduled_at,
            s.name AS site_name, s.contact_phone
     FROM service_tickets t
     JOIN sites s ON s.id = t.site_id
     WHERE t.status NOT IN ('COMPLETED', 'CANCELLED')
       AND t.scheduled_at IS NOT NULL AND trim(t.scheduled_at) <> ''
       AND date(t.scheduled_at) >= ? AND date(t.scheduled_at) < ?
     ORDER BY t.scheduled_at ASC, t.id ASC
     LIMIT 50"
    [start-date end-date-exclusive]))

;; 점검 대상: 다음 주 구간에 warranty_ends_at이 도래하는 ACTIVE 장비.
;; service_visits.next_inspection_at(완료 이력의 다음 점검 예정)은 쓰지
;; 않는다 — 2주차 warranty_expiring과 동일하게 보증만료를 점검 트리거로 쓴다.
(defn count-ops-weekly-inspection-due [start-date end-date-exclusive]
  (get (first (db_query DB
    "SELECT COUNT(*) AS c
     FROM equipment e
     WHERE e.status = 'ACTIVE'
       AND e.warranty_ends_at IS NOT NULL
       AND date(e.warranty_ends_at) >= ? AND date(e.warranty_ends_at) < ?"
    [start-date end-date-exclusive])) :c))

(defn list-ops-weekly-inspection-due [start-date end-date-exclusive]
  (db_query DB
    "SELECT e.id, e.model, e.category, e.warranty_ends_at, e.status,
            s.id AS site_id, s.name AS site_name, s.contact_phone
     FROM equipment e
     JOIN sites s ON s.id = e.site_id
     WHERE e.status = 'ACTIVE'
       AND e.warranty_ends_at IS NOT NULL
       AND date(e.warranty_ends_at) >= ? AND date(e.warranty_ends_at) < ?
     ORDER BY e.warranty_ends_at ASC, e.id ASC
     LIMIT 50"
    [start-date end-date-exclusive]))

(defn get-ops-weekly [as-of]
  (let [resolved-as-of (resolve-ops-weekly-as-of as-of)
        week (next-iso-week-info resolved-as-of)
        start-date (get week :start_date)
        end-date-exclusive (get (first (db_query DB "SELECT date(?, '+7 days') AS v" [start-date])) :v)]
    {:as_of resolved-as-of
     :timezone "Asia/Seoul"
     :week week
     :unprocessed {:count (count-ops-weekly-unprocessed) :items (list-ops-weekly-unprocessed)}
     :visits_next_week {:count (count-ops-weekly-visits start-date end-date-exclusive)
                         :items (list-ops-weekly-visits start-date end-date-exclusive)}
     :inspection_due {:count (count-ops-weekly-inspection-due start-date end-date-exclusive)
                       :items (list-ops-weekly-inspection-due start-date end-date-exclusive)}}))

;; ---- 연간관리 CarePlan (4주차, docs/09 §5 — site_id 앵커, payment_status 없음) ----
;;
;; 확정 규칙(Codex, 2026-07-21):
;;  - plan_code 3종: TRIAL_90(90일)/BASIC_360(365일)/FIELD_790(365일).
;;    포함 방문 기본값 0/0/2, 가격 스냅샷 기본값 99000/360000/790000원(가입 시
;;    override 허용, 음수 금지).
;;  - 종료일은 시작일 포함 계산: ends_at = starts_at + (기간일수 - 1).
;;  - 저장 status는 ACTIVE/CANCELLED/RENEWED 세 가지뿐이고 시간 경과로 자동
;;    전이하지 않는다(이 저장소의 다른 상태 머신과 동일 원칙 — quotes도
;;    valid_until이 지나도 자동 EXPIRED 안 됨). "만료됨"은 응답 조립 시
;;    effective_status로만 파생한다(with-effective-status).
;;  - 하드 삭제 없음. 같은 site_id에 겹치는 비취소(ACTIVE/RENEWED) 기간은
;;    트랜잭션 내에서 거부. 갱신은 기존 ACTIVE를 RENEWED로 바꾸고 새 행을
;;    삽입하는 방식(quotes→contracts 전환과 동일 오케스트레이션 패턴).
;;  - used_visits는 자동 차감 없이 PUT으로 절대값을 받는다(재시도 멱등).

(defn valid-plan-code? [plan-code]
  (or (= plan-code "TRIAL_90") (= plan-code "BASIC_360") (= plan-code "FIELD_790")))

(defn careplan-plan-defaults [plan-code]
  (cond
    [(= plan-code "TRIAL_90") {:days 90 :visits 0 :price 99000}]
    [(= plan-code "BASIC_360") {:days 365 :visits 0 :price 360000}]
    [(= plan-code "FIELD_790") {:days 365 :visits 2 :price 790000}]
    [true (error "plan_code must be one of TRIAL_90, BASIC_360, FIELD_790")]))

(defn careplan-today []
  (get (first (db_query DB "SELECT date('now', '+9 hours') AS v" [])) :v))

;; 시작일 포함 계산: 90일 플랜이면 starts_at 당일이 1일째라 +89일이 마지막날.
(defn careplan-ends-at [starts-at days]
  (get (first (db_query DB "SELECT date(?, '+' || ? || ' days') AS v" [starts-at (- days 1)])) :v))

;; 저장된 status는 그대로 두고, ACTIVE인데 종료일이 지났으면 응답에서만
;; EXPIRED로 보여준다 — 배치 없이 항상 최신 상태를 보장하는 파생 필드.
(defn with-effective-status [row today]
  (assoc row :effective_status
    (if (and (= (get row :status) "ACTIVE") (< (get row :ends_at) today))
      "EXPIRED"
      (get row :status))))

(defn get-careplan [id]
  (let [row (first (db_query DB "SELECT * FROM care_plans WHERE id = ?" [id]))]
    (if (nil? row) nil (with-effective-status row (careplan-today)))))

(defn list-site-careplans [site-id]
  (let [today (careplan-today)]
    (map (fn [row] (with-effective-status row today))
         (db_query DB
           "SELECT * FROM care_plans WHERE site_id = ? ORDER BY starts_at DESC, id DESC"
           [site-id]))))

(defn list-customer-careplans [customer-id]
  (let [today (careplan-today)]
    (map (fn [row] (with-effective-status row today))
         (db_query DB
           "SELECT cp.* FROM care_plans cp
            JOIN sites s ON s.id = cp.site_id
            WHERE s.customer_id = ?
            ORDER BY cp.starts_at DESC, cp.id DESC"
           [customer-id]))))

;; 겹침 판정: 비취소(ACTIVE/RENEWED) 기존 행 중 [starts-at, ends-at]과 날짜
;; 구간이 하나라도 겹치면 true. RENEWED도 막는 이유는 갱신으로 이미 닫힌
;; 기간이라도 그 날짜 구간 자체는 여전히 "그 시점에 유효했던 계약"이라
;; 다른 신규 가입과 겹치면 안 되기 때문(취소만 진짜 무효).
(defn site-has-overlapping-careplan? [site-id starts-at ends-at]
  (> (get (first (db_query DB
          "SELECT COUNT(*) AS c FROM care_plans
           WHERE site_id = ? AND status <> 'CANCELLED'
             AND starts_at <= ? AND ends_at >= ?"
          [site-id ends-at starts-at])) :c) 0))

(defn create-care-plan [site-id plan-code starts-at price-override included-visits-override next-inspection-at memo]
  (if (nil? (find-site site-id))
    (error "Site not found"))
  (let [resolved-starts-at (if (or (nil? starts-at) (str-blank? starts-at)) (careplan-today) starts-at)
        defaults (careplan-plan-defaults plan-code)
        days (get defaults :days)
        price-raw (if (nil? price-override) nil (str price-override))
        visits-raw (if (nil? included-visits-override) nil (str included-visits-override))
        price (if (nil? price-override) (get defaults :price) (int price-raw))
        included-visits (if (nil? included-visits-override) (get defaults :visits) (int visits-raw))
        ends-at (careplan-ends-at resolved-starts-at days)]
    (if (not (valid-calendar-date? resolved-starts-at))
      (error "starts_at must be a valid YYYY-MM-DD date"))
    (if (and (not (nil? next-inspection-at)) (not (valid-calendar-date? next-inspection-at)))
      (error "next_inspection_at must be a valid YYYY-MM-DD date"))
    (if (and (not (nil? price-override)) (not (regex_match price-raw "^[0-9]+$")))
      (error "price_snapshot must be a non-negative integer"))
    (if (and (not (nil? included-visits-override)) (not (regex_match visits-raw "^[0-9]+$")))
      (error "included_visits must be a non-negative integer"))
    (if (< price 0) (error "price_snapshot must not be negative"))
    (if (< included-visits 0) (error "included_visits must not be negative"))
    (db_exec DB "BEGIN TRANSACTION" [])
    (try
      (do
        (if (site-has-overlapping-careplan? site-id resolved-starts-at ends-at)
          (error "Site already has an overlapping non-cancelled care plan for this period"))
        (db_exec DB
          "INSERT INTO care_plans
           (site_id, plan_code, status, starts_at, ends_at, price_snapshot, included_visits, used_visits, next_inspection_at, memo)
           VALUES (?, ?, 'ACTIVE', ?, ?, ?, ?, 0, ?, ?)"
          [site-id plan-code resolved-starts-at ends-at price included-visits next-inspection-at memo])
        (let [new-id (inserted-id "care_plans")]
          (db_exec DB "COMMIT" [])
          (get-careplan new-id)))
      (catch [e]
        (do
          (try (db_exec DB "ROLLBACK" []) (catch [re] false))
          (error (str e)))))))

;; used_visits는 절대값으로만 받는다(재시도해도 같은 값을 다시 보내면 결과가
;; 동일 — 자동 차감이 없으므로 그 자체로 멱등). 누락된 필드(nil)는 기존 값을
;; 유지한다(COALESCE) — memo/next_inspection_at도 동일 원칙.
(defn update-care-plan [id used-visits next-inspection-at memo]
  (let [rows (db_query DB "SELECT * FROM care_plans WHERE id = ?" [id])]
    (if (= (length rows) 0) (error "Care plan not found"))
    (let [current (first rows)
          status (get current :status)
          included-visits (get current :included_visits)
          used-raw (if (nil? used-visits) nil (str used-visits))
          resolved-used-visits (if (nil? used-visits) (get current :used_visits) (int used-raw))]
      (if (not (= status "ACTIVE"))
        (error "Only ACTIVE care plans can be updated"))
      (if (and (not (nil? used-visits)) (not (regex_match used-raw "^[0-9]+$")))
        (error "used_visits must be a non-negative integer"))
      (if (or (< resolved-used-visits 0) (> resolved-used-visits included-visits))
        (error (str "used_visits must be between 0 and " included-visits)))
      (if (and (not (nil? next-inspection-at)) (not (valid-calendar-date? next-inspection-at)))
        (error "next_inspection_at must be a valid YYYY-MM-DD date"))
      (db_exec DB "BEGIN TRANSACTION" [])
      (try
        (do
          (db_exec DB
            "UPDATE care_plans
             SET used_visits = ?, next_inspection_at = COALESCE(?, next_inspection_at),
                 memo = COALESCE(?, memo), updated_at = CURRENT_TIMESTAMP
             WHERE id = ?"
            [resolved-used-visits next-inspection-at memo id])
          (db_exec DB "COMMIT" [])
          (get-careplan id))
        (catch [e]
          (do
            (try (db_exec DB "ROLLBACK" []) (catch [rollback-error] false))
            (error (str e))))))))

(defn cancel-care-plan [id memo]
  (let [rows (db_query DB "SELECT * FROM care_plans WHERE id = ?" [id])]
    (if (= (length rows) 0) (error "Care plan not found"))
    (if (not (= (get (first rows) :status) "ACTIVE"))
      (error "Only ACTIVE care plans can be cancelled"))
    (db_exec DB "BEGIN TRANSACTION" [])
    (try
      (do
        (db_exec DB
          "UPDATE care_plans
           SET status = 'CANCELLED', memo = COALESCE(?, memo), updated_at = CURRENT_TIMESTAMP
           WHERE id = ?"
          [memo id])
        (db_exec DB "COMMIT" [])
        (get-careplan id))
      (catch [e]
        (do
          (try (db_exec DB "ROLLBACK" []) (catch [rollback-error] false))
          (error (str e)))))))

(defn renew-care-plan [id plan-code-override starts-at-override price-override included-visits-override]
  (let [rows (db_query DB "SELECT * FROM care_plans WHERE id = ?" [id])]
    (if (= (length rows) 0) (error "Care plan not found"))
    (let [old (first rows)
          plan-code (if (nil? plan-code-override) (get old :plan_code) plan-code-override)
          resolved-starts-at (if (or (nil? starts-at-override) (str-blank? starts-at-override))
                               (get (first (db_query DB "SELECT date(?, '+1 day') AS v" [(get old :ends_at)])) :v)
                               starts-at-override)
          defaults (careplan-plan-defaults plan-code)
          days (get defaults :days)
          price-raw (if (nil? price-override) nil (str price-override))
          visits-raw (if (nil? included-visits-override) nil (str included-visits-override))
          price (if (nil? price-override) (get defaults :price) (int price-raw))
          included-visits (if (nil? included-visits-override) (get defaults :visits) (int visits-raw))
          ends-at (careplan-ends-at resolved-starts-at days)]
      (if (not (= (get old :status) "ACTIVE"))
        (error "Only ACTIVE care plans can be renewed"))
      (if (not (valid-calendar-date? resolved-starts-at))
        (error "starts_at must be a valid YYYY-MM-DD date"))
      (if (and (not (nil? price-override)) (not (regex_match price-raw "^[0-9]+$")))
        (error "price_snapshot must be a non-negative integer"))
      (if (and (not (nil? included-visits-override)) (not (regex_match visits-raw "^[0-9]+$")))
        (error "included_visits must be a non-negative integer"))
      (if (< price 0) (error "price_snapshot must not be negative"))
      (if (< included-visits 0) (error "included_visits must not be negative"))
      (if (site-has-overlapping-careplan? (get old :site_id) resolved-starts-at ends-at)
        (error "Site already has an overlapping non-cancelled care plan for this period"))
      (db_exec DB "BEGIN TRANSACTION" [])
      (try
        (do
          (db_exec DB
            "UPDATE care_plans SET status = 'RENEWED', updated_at = CURRENT_TIMESTAMP
             WHERE id = ? AND status = 'ACTIVE'"
            [id])
          (if (= (get (first (db_query DB "SELECT changes() AS changed" [])) :changed) 0)
            (error "Only ACTIVE care plans can be renewed"))
          (db_exec DB
            "INSERT INTO care_plans
             (site_id, plan_code, status, starts_at, ends_at, price_snapshot, included_visits, used_visits, renewed_from_id, memo)
             VALUES (?, ?, 'ACTIVE', ?, ?, ?, ?, 0, ?, ?)"
            [(get old :site_id) plan-code resolved-starts-at ends-at price included-visits id (get old :memo)])
          (let [new-id (inserted-id "care_plans")]
            (db_exec DB "COMMIT" [])
            (get-careplan new-id)))
      (catch [e]
        (do
          (try (db_exec DB "ROLLBACK" []) (catch [re] false))
          (error (str e))))))))

;; ---- 상담 관리 (고객관리 1차) ----

(defn valid-consultation-method? [method]
  (or (= method "PHONE")
      (= method "SMS")
      (= method "KAKAO")
      (= method "VISIT")
      (= method "OTHER")))

(defn valid-next-action? [action]
  (or (= action "NONE")
      (= action "CALLBACK")
      (= action "QUOTE")
      (= action "SERVICE_TICKET")
      (= action "SALE")
      (= action "CONTRACT_REVIEW")))

(defn create-consultation [customer-id consulted-at method content next-action next-contact-at]
  (let [resolved-method (if (nil? method) "PHONE" method)
        resolved-action (if (nil? next-action) "NONE" next-action)]
    (if (not (valid-consultation-method? resolved-method))
      (error "method must be one of PHONE, SMS, KAKAO, VISIT, OTHER"))
    (if (not (valid-next-action? resolved-action))
      (error "next_action must be one of NONE, CALLBACK, QUOTE, SERVICE_TICKET, SALE, CONTRACT_REVIEW"))
    (do
      (db_exec DB
        "INSERT INTO consultations
         (customer_id, consulted_at, method, content, next_action, next_contact_at)
         VALUES (?, ?, ?, ?, ?, ?)"
        [customer-id consulted-at resolved-method content resolved-action next-contact-at])
      (let [id (inserted-id "consultations")]
        (first (db_query DB "SELECT * FROM consultations WHERE id = ?" [id]))))))

(defn list-customer-consultations [customer-id]
  (db_query DB
    "SELECT * FROM consultations WHERE customer_id = ? ORDER BY consulted_at DESC"
    [customer-id]))

(defn complete-consultation [id]
  (do
    (db_exec DB "UPDATE consultations SET completed_at = CURRENT_TIMESTAMP WHERE id = ?" [id])
    (first (db_query DB "SELECT * FROM consultations WHERE id = ?" [id]))))

(defn list-followups-today []
  (db_query DB
    "SELECT c.id, c.customer_id, c.next_contact_at, c.next_action, c.content,
            cu.name AS customer_name, cu.phone
     FROM consultations c
     JOIN customers cu ON cu.id = c.customer_id
     WHERE c.completed_at IS NULL
       AND c.next_contact_at IS NOT NULL
       AND date(c.next_contact_at) <= date('now')
     ORDER BY c.next_contact_at"
    []))

(defn list-recent-consultations [limit]
  (db_query DB
    "SELECT c.id, c.customer_id, c.consulted_at, c.method, c.content,
            cu.name AS customer_name, cu.phone
     FROM consultations c
     JOIN customers cu ON cu.id = c.customer_id
     ORDER BY c.consulted_at DESC LIMIT ?"
    [limit]))

(defn list-pending-next-actions []
  (db_query DB
    "SELECT c.id, c.customer_id, c.next_action, c.next_contact_at, c.content,
            cu.name AS customer_name, cu.phone
     FROM consultations c
     JOIN customers cu ON cu.id = c.customer_id
     WHERE c.completed_at IS NULL AND c.next_action <> 'NONE'
     ORDER BY c.consulted_at DESC"
    []))

;; ---- 고객관리 2차: 담당자/할 일/사후관리 ----

(defn valid-contact-role? [role]
  (or (= role "OWNER")
      (= role "MANAGER")
      (= role "SITE_MANAGER")
      (= role "ACCOUNTING")
      (= role "PURCHASING")
      (= role "FACILITY")
      (= role "OTHER")))

(defn valid-contact-status? [status]
  (or (= status "ACTIVE")
      (= status "INACTIVE")))

(defn create-customer-contact [customer-id name position department phone email role is-primary status memo]
  (let [resolved-role (if (nil? role) "OTHER" role)
        resolved-primary (if (= is-primary true) 1 (if (= is-primary 1) 1 0))
        resolved-status (if (nil? status) "ACTIVE" status)]
    (if (not (valid-contact-role? resolved-role))
      (error "role must be one of OWNER, MANAGER, SITE_MANAGER, ACCOUNTING, PURCHASING, FACILITY, OTHER"))
    (if (not (valid-contact-status? resolved-status))
      (error "status must be ACTIVE or INACTIVE"))
    (do
      (db_exec DB
        "INSERT INTO customer_contacts
         (customer_id, name, position, department, phone, email, role, is_primary, status, memo)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
        [customer-id name position department phone email resolved-role resolved-primary resolved-status memo])
      (let [id (inserted-id "customer_contacts")]
        (first (db_query DB "SELECT * FROM customer_contacts WHERE id = ?" [id]))))))

(defn list-customer-contacts [customer-id]
  (db_query DB
    "SELECT * FROM customer_contacts
     WHERE customer_id = ?
     ORDER BY is_primary DESC, created_at DESC, id DESC"
    [customer-id]))

(defn valid-task-priority? [priority]
  (or (= priority "LOW")
      (= priority "NORMAL")
      (= priority "HIGH")))

(defn valid-task-status? [status]
  (or (= status "PENDING")
      (= status "IN_PROGRESS")
      (= status "DONE")
      (= status "DELAYED")
      (= status "CANCELLED")))

(defn create-customer-task [customer-id title due-at priority memo]
  (let [resolved-priority (if (nil? priority) "NORMAL" priority)]
    (if (not (valid-task-priority? resolved-priority))
      (error "priority must be LOW, NORMAL, or HIGH"))
    (do
      (db_exec DB
        "INSERT INTO customer_tasks (customer_id, title, due_at, priority, memo)
         VALUES (?, ?, ?, ?, ?)"
        [customer-id title due-at resolved-priority memo])
      (let [id (inserted-id "customer_tasks")]
        (first (db_query DB "SELECT * FROM customer_tasks WHERE id = ?" [id]))))))

(defn list-customer-tasks [customer-id]
  (db_query DB
    "SELECT * FROM customer_tasks
     WHERE customer_id = ?
     ORDER BY (due_at IS NULL), due_at, id DESC"
    [customer-id]))

(defn complete-customer-task [id]
  (do
    (db_exec DB
      "UPDATE customer_tasks
       SET status = 'DONE', completed_at = CURRENT_TIMESTAMP
       WHERE id = ?"
      [id])
    (first (db_query DB "SELECT * FROM customer_tasks WHERE id = ?" [id]))))

(defn valid-followup-type? [followup-type]
  (or (= followup-type "CONSULT_RECALL")
      (= followup-type "QUOTE_CHECK")
      (= followup-type "INSTALL_CHECK")
      (= followup-type "SERVICE_CHECK")
      (= followup-type "REPAIR_RECHECK")
      (= followup-type "PAYMENT_NOTICE")
      (= followup-type "CONSUMABLE_NOTICE")
      (= followup-type "WARRANTY_END_NOTICE")
      (= followup-type "CARE_PLAN_RENEWAL")
      (= followup-type "LONG_TERM_INACTIVE")))

(defn create-customer-followup [customer-id followup-type scheduled-at contact-method result customer-reaction next-followup-at]
  (let [resolved-type (if (nil? followup-type) "CONSULT_RECALL" followup-type)]
    (if (not (valid-followup-type? resolved-type))
      (error "followup_type is invalid"))
    (if (and (not (nil? contact-method)) (not (valid-consultation-method? contact-method)))
      (error "contact_method must be one of PHONE, SMS, KAKAO, VISIT, OTHER"))
    (do
      (db_exec DB
        "INSERT INTO customer_followups
         (customer_id, followup_type, scheduled_at, contact_method, result, customer_reaction, next_followup_at)
         VALUES (?, ?, ?, ?, ?, ?, ?)"
        [customer-id resolved-type scheduled-at contact-method result customer-reaction next-followup-at])
      (let [id (inserted-id "customer_followups")]
        (first (db_query DB "SELECT * FROM customer_followups WHERE id = ?" [id]))))))

(defn list-customer-followups [customer-id]
  (db_query DB
    "SELECT * FROM customer_followups
     WHERE customer_id = ?
     ORDER BY scheduled_at DESC, id DESC"
    [customer-id]))

(defn complete-customer-followup [id]
  (do
    (db_exec DB
      "UPDATE customer_followups
       SET completed_at = CURRENT_TIMESTAMP
       WHERE id = ?"
      [id])
    (first (db_query DB "SELECT * FROM customer_followups WHERE id = ?" [id]))))
