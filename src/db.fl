;;; Database Schema for BigWash Contract System

(define DB
  (let [override (env-get "BIGWASH_DB_PATH")]
    (if (or (nil? override) (str-blank? override))
      "/root/kim/bigwash-contract/db/contracts.sqlite"
      override)))

;;; Initialize database
(defn init-db []
  (do
    ;; Contracts table
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS contracts (
        id INTEGER PRIMARY KEY,
        number TEXT UNIQUE NOT NULL,
        status TEXT DEFAULT 'DRAFT',
        client_id INTEGER NOT NULL,
        amount REAL NOT NULL,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      )")

    ;; Contract items table
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS contract_items (
        id INTEGER PRIMARY KEY,
        contract_id INTEGER NOT NULL,
        description TEXT NOT NULL,
        quantity INTEGER NOT NULL,
        unit_price REAL NOT NULL,
        subtotal REAL NOT NULL,
        FOREIGN KEY(contract_id) REFERENCES contracts(id)
      )")

    ;; Audit log
    (db_exec DB
      "CREATE TABLE IF NOT EXISTS contract_history (
        id INTEGER PRIMARY KEY,
        contract_id INTEGER NOT NULL,
        old_status TEXT,
        new_status TEXT,
        changed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(contract_id) REFERENCES contracts(id)
      )")

    (println "✓ Database initialized")))

;;; Utility functions
(defn get-db [] DB)

;;; 문서 번호 생성 (계약/견적 공용) — 예: (generate-doc-number "CTR") -> "CTR-1784...-4821"
(defn generate-doc-number [prefix]
  (str prefix "-" (now_ms) "-" (+ 1000 (floor (* (random) 8999)))))

(init-db)
