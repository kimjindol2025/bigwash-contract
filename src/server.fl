;;; BigWash Contract Server

;; 이 저장소는 노드마다 경로가 다르다(/root/kim/... vs /home/kim/kim/...).
;; load는 entry 파일 기준 절대경로가 아니면 엉뚱한 곳을 찾으므로, 배포 위치와
;; 무관하게 항상 저장소 루트에서 실행한다는 전제로 PWD를 기준 삼는다.
;; BIGWASH_REPO_ROOT를 명시하면 그쪽을 우선한다(pm2 등 PWD가 안 잡히는 환경용).
(define REPO-ROOT
  (let [override (env-get "BIGWASH_REPO_ROOT")]
    (if (or (nil? override) (str-blank? override)) (env-get "PWD") override)))

(load (str REPO-ROOT "/src/db.fl"))
(load (str REPO-ROOT "/src/contract.fl"))
(load (str REPO-ROOT "/src/pages.fl"))

;;; 테스트 데이터
(define sample-contracts [
  {:id "BW-2026-0001" :client "(주)세차마을 서울지점" :type "장비공급"
   :amount "₩8.5M" :status "signed" :date "2026-04-28"}
  {:id "BW-2026-0002" :client "강남 세차카페" :type "설치시공"
   :amount "₩12.3M" :status "sent" :date "2026-04-25"}
  {:id "BW-2026-0003" :client "대전광역시 환경미화" :type "유지보수"
   :amount "₩2.8M" :status "draft" :date "2026-04-20"}
])

;;; GET / — 대시보드
(defn handle-get-dashboard [$req]
  (server_html (render-dashboard sample-contracts)))

;;; GET /contract/new — 새 계약서 폼
(defn handle-get-new-contract [$req]
  (server_html (render-new-contract)))

;;; GET /review/phase0 — 검수 트리 페이지
(defn handle-get-phase0-review [$req]
  (server_html (render-phase0-review-tree)))

;;; POST /api/contracts — 계약서 생성
(defn handle-post-contract [$req]
  (try
    (do
      (let [[body (server_req_json $req)]]
        (let [[result (create-contract
                        (get body :customerId 0)
                        (get body :amount 0)
                        (get body :items []))]]
          (server_json {:ok true :data result}))))
    (catch [e]
      (server_json {:ok false :error (str e)}))))

;;; GET /api/contracts — 계약서 목록
(defn handle-get-contracts [$req]
  (let [[status (server_req_query $req "status")]]
    (server_json {:ok true :data (if status
                                   (list-contracts status)
                                   sample-contracts)})))

;;; 라우트 등록
(server_get    "/"              "handle-get-dashboard")
(server_get    "/contract/new"  "handle-get-new-contract")
(server_get    "/review/phase0" "handle-get-phase0-review")
(server_post   "/api/contracts" "handle-post-contract")
(server_get    "/api/contracts" "handle-get-contracts")

;;; 서버 시작
(println "🚀 BigWash Contract Server 시작")
(println "📍 http://localhost:40100")
(println "")
(server_start 40100)
